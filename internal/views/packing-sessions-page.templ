package views

import (
	"camplist/internal/auth"
	"camplist/internal/packing"
	"time"
)

templ PackingSessionsOverviewPage(name string, sessions []packing.PackingSession, csrfToken string) {
	@Layout(name, csrfToken) {
		<section>
			<div class="flex flex-wrap justify-between items-start gap-4 mb-6 max-sm:flex-col max-sm:items-stretch">
				<div class="min-w-0 max-sm:flex-none sm:flex-[1_1_320px]">
					<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700 mb-2">Sessions</p>
					<h1>Trips in progress</h1>
					<p class="text-muted max-w-[60ch]">Each session is a snapshot of a list. Check things off without touching the list.</p>
				</div>
			</div>
			if len(sessions) == 0 {
				<div class="card">
					<p class="text-muted">No packing sessions yet. <a href="/">Choose a list</a> to start packing.</p>
				</div>
			}
			for _, s := range sessions {
				<article class="card">
					if s.IsShared() {
						<p class="inline-block whitespace-nowrap text-xs font-bold tracking-tag uppercase text-pine-700 bg-pine-100 px-2 py-0.5 rounded-full mb-2">Shared</p>
					}
					<div class="flex flex-wrap justify-between items-start gap-4 mb-4 max-sm:flex-col">
						<div class="min-w-0 max-sm:flex-none sm:flex-[1_1_240px]">
							<h2><a class="no-underline" href={ "/packing-session/" + s.ID }>{ s.List.Name }</a></h2>
							<p class="text-muted mb-3">Started <time datetime={ s.CreatedAt.Format(time.RFC3339) }>{ s.CreatedAt.Format("Jan 2, 2006") }</time></p>
						</div>
						<div class="flex flex-wrap items-center gap-2 max-sm:w-full">
							if allPacked(s.List.CountChecked(), len(s.List.Items)) {
								<a class="btn btn-secondary btn-sm" href={ "/packing-session/" + s.ID }>Open</a>
							} else {
								<a class="btn btn-primary btn-sm max-sm:flex-auto" href={ "/packing-session/" + s.ID }>Keep packing</a>
							}
							@Menu("More") {
								@MenuLink("/sharing/packing-session/"+s.ID, "Sharing")
								if s.UserID == auth.Subject(ctx) {
									@MenuLink("/packing-session/"+s.ID+"/review", "Review this trip")
									@MenuSeparator()
									@MenuButton("Delete session", true, confirmDelete("/packing-session/"+s.ID, csrfToken, "Delete this session?", "Delete session", "Packing progress for this trip is lost. The list itself stays."))
								}
							}
						</div>
					</div>
					@ProgressBar(s.List.CountChecked(), len(s.List.Items), "")
				</article>
			}
		</section>
	}
}
