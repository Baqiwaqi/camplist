package views

import "camplist/internal/packing"

templ NewPackingListPage(name string, heading string, form packing.CreatePackingListForm, csrfToken string) {
	@Layout(name, csrfToken) {
		<section class="narrow">
			<p class="eyebrow">{ name }</p>
			<h1>{ heading }</h1>
			<p class="muted lede">Save your regular gear here and reuse it for future trips.</p>
			<div class="card">
				@PackingListForm(form, csrfToken)
			</div>
		</section>
	}
}

templ PackingListForm(form packing.CreatePackingListForm, csrfToken string) {
	<form method="post" action={ form.Action } hx-boost="true">
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<input type="hidden" name="revision" value={ form.Revision }/>
		<div class={ "field", templ.KV("field-error", form.NameHasError()) }>
			<label for="name">Name</label>
			<input id="name" name="name" type="text" placeholder="Camping" value={ form.Name }/>
		</div>
		<div class="field">
			<label for="description">Description</label>
			<textarea id="description" name="description" placeholder="A short description of your list">{ form.Description }</textarea>
		</div>
		if len(form.Error) > 0 {
			@ErrorBanner(form.Error)
		}
		<div class="form-actions">
			<a class="btn btn-secondary" href="/">Cancel</a>
			<button type="submit" class="btn btn-primary">{ form.SubmitButtonText }</button>
		</div>
	</form>
}
