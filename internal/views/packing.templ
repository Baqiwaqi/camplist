package views

import "camplist/internal/packing"
import "camplist/internal/auth"

templ PackingListPage(name string, lists []packing.PackingList, csrfToken string) {
	@Layout(name, csrfToken) {
		<section>
			<div class="page-head">
				<div>
					<p class="eyebrow">Your lists</p>
					<h1>Where to next?</h1>
					<p class="muted lede">Keep reusable lists for your camping trips. Start a fresh packing session each time you go.</p>
				</div>
				<div class="actions">
					<a class="btn btn-primary" href="/packing-list/new">Create list</a>
				</div>
			</div>
			if len(lists) == 0 {
				<div class="card">
					<p class="muted">No packing lists yet. Create one with the gear you regularly take.</p>
				</div>
			}
			for _, list := range lists {
				<article class="card">
					if list.IsShared() {
						<p class="tag">Shared</p>
					}
					<div class="card-head">
						<div>
							<h2><a href={ "/packing-list/" + list.ID }>{ list.Name }</a></h2>
							if list.Description != "" {
								<p class="muted">{ list.Description }</p>
							}
							<div class="categories">
								<span class="tag">{ itemSummary(list.Items) }</span>
								for _, category := range categories(list.Items, 4) {
									<span>{ category }</span>
								}
							</div>
						</div>
						<div class="actions">
							<a class="btn btn-secondary btn-sm" href={ "/packing-list/" + list.ID + "/edit" }>Edit</a>
							<a class="btn btn-secondary btn-sm" href={ "/packing-list/" + list.ID }>Details</a>
							if list.UserID==auth.Subject(ctx) {
								<button
									class="btn btn-danger btn-sm"
									hx-delete={ "/packing-list/" + list.ID }
									hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` }
									hx-confirm="Delete this list?"
									data-confirm-action="Delete list"
									data-confirm-detail="Sessions you already started keep their own copy."
								>Delete</button>
							}
						</div>
					</div>
				</article>
			}
		</section>
	}
}
