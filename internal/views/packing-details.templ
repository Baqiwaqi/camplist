package views

import (
	"camplist/internal/auth"
	"camplist/internal/packing"
	"strconv"
	"time"
)

// PackingDetails is a reusable list: its head with More, the pine panel that
// starts a trip, the gear and the preparation tasks. The head's actions stay
// beside the title on phones too, and its tags follow it closely.
templ PackingDetails(name string, list packing.PackingList, form packing.CreateItemForm, csrfToken string) {
	@Layout(name, csrfToken) {
		<section class="[&_.page-head]:flex-nowrap [&_.page-head]:mb-3">
			@PageHead(PageHeading{
				Title:     list.Name,
				Meta:      list.Description,
				BackHref:  "/packing-lists",
				BackLabel: "Packing lists",
			}) {
				@PageMenu("More") {
					@MenuLink("/packing-lists/"+list.ID+"/edit", "Edit name and description")
					@MenuLink("/sharing/packing-list/"+list.ID, "Sharing")
					if list.UserID == auth.Subject(ctx) {
						@MenuSeparator()
						@MenuButton("Delete list", true, confirmDelete("/packing-lists/"+list.ID, "Delete this list?", "Delete list", "Trips you already started keep their own copy."))
					}
				}
			}
			<div class="flex flex-wrap items-center gap-2">
				if label := sharedLabel(list, auth.Subject(ctx)); label != "" {
					<span class="tag">{ label }</span>
				}
				@ListSummary(list.Items, false)
			</div>
			<div class="card card-brand mt-5 mb-0">
				@StartTripForm(StartTrip{List: list, Name: list.Name + " – " + time.Now().Format("Jan 2, 2006"), Members: list.TripMemberChoices(auth.Subject(ctx))}, csrfToken)
				<p class="mt-2 text-meta text-pine-100">You pack from a copy. This list stays as it is.</p>
			</div>
		</section>
		@ListRevision(list, false)
		<section id="gear" class="mt-8">
			@SectionHead("Gear", gearCount(list.Items))
			<div class="card p-0 mb-0">
				<div class="p-4 border-b border-sand-200">
					@AddItemForm(form, csrfToken, false)
					@ListAddStatus("", false)
					<div class="mt-3">
						@BulkAddActions(list.ID)
					</div>
				</div>
				@ListGear(list, "", false)
			</div>
		</section>
		<section class="mt-8">
			@ListPreparation(list, csrfToken, false, "")
		</section>
		@BulkAddDialog()
	}
}

// ListRevision holds the list revision the page shows, once. Every save on the
// page is conditioned on it: static/revision.js sends it in place of the copy
// a control was rendered with, and each save swaps in the revision it made.
templ ListRevision(list packing.PackingList, oob bool) {
	<input
		type="hidden"
		id="list-revision"
		value={ list.Revision() }
		if oob {
			hx-swap-oob="true"
		}
	/>
}

// ListSummary is the meta line under the list's title, e.g. "16 items in 7
// categories".
templ ListSummary(items []packing.PackingItem, oob bool) {
	<p
		id="list-summary"
		class="text-meta text-muted"
		if oob {
			hx-swap-oob="true"
		}
	>{ listSummary(items) }</p>
}

// GearCount updates the Gear section's count out of band.
templ GearCount(items []packing.PackingItem) {
	<span hx-swap-oob="innerHTML:#gear .section-count">{ gearCount(items) }</span>
}

// ListGear is the gear on the list page, grouped by category, or the empty
// text. Adding, deleting, recategorising an item or renaming a category can
// change the groups, so those saves swap all of it. Every row but focus carries
// hx-preserve, so a row open for editing stays open with what was typed; focus
// names the item whose saved row comes back with its Edit taking the keyboard.
// static/removal-focus.js reads data-empty-focus.
templ ListGear(list packing.PackingList, focus string, oob bool) {
	<div
		id="list-items"
		class="-mt-px pb-2 md:columns-2 md:gap-x-6"
		data-empty-focus="item-name-new"
		if oob {
			hx-swap-oob="true"
		}
	>
		if len(list.Items) == 0 {
			<p class="px-4 pt-4 pb-2 text-muted">No items yet. Add your first item above, paste several at once, or copy items from another list.</p>
		}
		for _, group := range groupByCategory(list.Items) {
			<div class="break-inside-avoid border-t border-sand-100 first:border-t-0">
				if group.Name != "" {
					<h3 class="flex items-baseline justify-between gap-3 px-4 pt-3 pb-1 m-0 font-sans text-meta font-bold tracking-normal wrap-anywhere">
						{ group.Name }
						<span class="font-semibold text-muted">{ strconv.Itoa(len(group.Items)) }</span>
					</h3>
				}
				<ul>
					for _, item := range group.Items {
						@itemRow(list.ID, item, item.ID == focus, item.ID != focus)
					}
				</ul>
			</div>
		}
	</div>
}

// ListPreparation is the "Prepare before your next trip" card. Every control
// in it swaps the whole card, because a save changes the done count, the edit
// toggle and the empty text. editing seeds the card's edit mode so a rename or
// removal keeps it open, and focus is the id of the field to focus after the
// swap. Each form also posts normally and redirects when scripts are off.
templ ListPreparation(list packing.PackingList, csrfToken string, editing bool, focus string) {
	<section id="list-preparation" class="card p-0" x-data={ "{ editing: " + strconv.FormatBool(editing) + " }" }>
		<div class="px-4 pt-4 sm:px-6 sm:pt-5">
			<h2>Prepare before your next trip</h2>
			<p class="text-muted max-w-[60ch]">Done tasks start every new trip as handled. They never mark gear as packed.</p>
			if len(list.Tasks) > 0 {
				<div class="flex flex-wrap items-center justify-between gap-3 mt-3">
					<span class="tag">{ preparationSummary(list.Tasks) }</span>
					<button type="button" class="btn btn-secondary btn-sm" x-on:click="editing = !editing" x-bind:aria-pressed="editing" x-text="editing ? 'Done editing' : 'Edit tasks'">Edit tasks</button>
				</div>
			}
		</div>
		<div class="px-4 sm:px-6 py-2">
			if len(list.Tasks) == 0 {
				<p class="py-2 text-muted">No tasks yet. Add one below, like buying fuel before you leave.</p>
			} else {
				@PreparationTasks(list, csrfToken, editing, focus)
			}
		</div>
		<form
			class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2 border-t border-sand-100 bg-sand-50 px-4 py-4 sm:grid-cols-[minmax(0,1fr)_11rem_auto] sm:px-6 rounded-b-card [&.htmx-request]:opacity-60"
			method="post"
			action={ "/packing-lists/" + list.ID + "/preparation/edit" }
			{ preparationSwap(list)... }
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			<input type="hidden" name="revision" value={ list.Revision() }/>
			<input type="hidden" name="editing" x-bind:value="editing"/>
			@Field(TextField{
				ID:          "new-task",
				Name:        "name",
				Label:       "New preparation task",
				Placeholder: "Like buying fuel",
				HideLabel:   true,
				Attrs:       templ.Attributes{"required": true, "maxlength": "200", "autofocus": focus == "new-task"},
			})
			<div class="max-sm:order-last max-sm:w-48">
				@ScopeSelect("scope", "new-task-scope", "", false, true)
			</div>
			<button class="btn btn-secondary min-h-11">Add task</button>
		</form>
		if len(list.Changes) > 0 {
			<div class="border-t border-sand-100 px-4 pb-4 sm:px-6">
				<h3>Improvements from trip reviews</h3>
				<ul>
					for _, change := range list.Changes {
						<li class="py-2 border-b border-sand-100 font-bold last:border-b-0">{ change }</li>
					}
				</ul>
			</div>
		}
	</section>
}

// PreparationTasks is the task list on the reusable list page.
templ PreparationTasks(list packing.PackingList, csrfToken string, editing bool, focus string) {
	<ul id="preparation-tasks">
		for i, task := range list.Tasks {
			@PreparationTaskRow(list, task, csrfToken, editing, focus, nextTaskID(list.Tasks, i))
		}
	</ul>
}

// StartTrip is the start-trip form's state. Members are the list members the
// signer may add to the new trip (PackingList.TripMemberChoices); with none,
// Start trip posts straight away as before.
type StartTrip struct {
	List   packing.PackingList
	Name   string
	Errors []string
	// MemberError marks Errors as about the chosen members, not the name.
	MemberError bool
	Members     []packing.Member
	// Chosen keeps ticked members when the prompt comes back with an error.
	Chosen map[string]bool
	// Prompt shows the member checkboxes; Page is the no-script page, whose
	// Cancel is a plain link; Focus puts the keyboard on Start trip after Cancel.
	Prompt, Page, Focus bool
}

// StartTripForm sits in the pine start panel. A started trip is a new page, so the
// server redirects; a rejected name swaps the form back in place with the
// error. hx-sync drops repeat presses while a start is in flight; once the
// redirect arrives the button is disabled, so neither a click nor Enter can
// start a second trip while the trip page loads (static/revision.js reloads
// the page when it returns from the back/forward cache).
//
// When the list has members to offer, Start trip first asks for them: the
// collapsed form GETs the prompt, which htmx swaps in place and which is a
// page of its own without scripts. The prompt then posts like the plain form.
templ StartTripForm(s StartTrip, csrfToken string) {
	if len(s.Members) > 0 && !s.Prompt {
		<form
			id="start-trip"
			method="get"
			action={ startTripPromptPath(s.List.ID) }
			hx-get={ string(startTripPromptPath(s.List.ID)) }
			hx-target="this"
			hx-swap="outerHTML"
			hx-sync="this:drop"
			class="flex flex-wrap items-end gap-2"
		>
			<input type="hidden" name="choose" value="members"/>
			@startTripName(s)
			<button
				class="btn btn-go max-sm:flex-auto"
				if s.Focus {
					autofocus
				}
			>Start trip</button>
		</form>
	} else {
		<form
			id="start-trip"
			method="post"
			action="/packing-lists/start-session"
			hx-post="/packing-lists/start-session"
			hx-target="this"
			hx-swap="outerHTML"
			hx-sync="this:drop"
			hx-on::after-request="if (event.detail.xhr.getResponseHeader('HX-Redirect')) this.querySelector('button[type=submit]').disabled = true"
			class={ "flex flex-wrap items-end gap-2", templ.KV("sm:max-w-[26rem]", s.Prompt) }
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/><input type="hidden" name="listId" value={ s.List.ID }/>
			@startTripName(s)
			if s.Prompt {
				@startTripMembers(s)
			}
			<button type="submit" class="btn btn-go max-sm:flex-auto">Start trip</button>
			if s.Prompt && s.Page {
				<a class="btn btn-secondary max-sm:flex-auto" href={ templ.SafeURL("/packing-lists/" + s.List.ID) }>Cancel</a>
			} else if s.Prompt {
				<a
					class="btn btn-secondary max-sm:flex-auto"
					href={ templ.SafeURL("/packing-lists/" + s.List.ID) }
					hx-get={ string(startTripPromptPath(s.List.ID)) }
					hx-include="#trip-name"
					hx-target="#start-trip"
					hx-swap="outerHTML"
				>Cancel</a>
			}
			if len(s.Errors) > 0 {
				<div id="trip-name-error" class="basis-full *:mb-0">
					@ErrorBanner(s.Errors)
				</div>
			}
		</form>
	}
}

templ startTripName(s StartTrip) {
	<div class={ "grid gap-1 min-w-0 flex-[1_1_16rem]", templ.KV("basis-full", s.Prompt) }>
		<label for="trip-name" class="text-sm font-bold text-pine-100">Trip name</label>
		<input
			id="trip-name"
			name="name"
			value={ s.Name }
			required
			maxlength="200"
			class="w-full min-h-11 rounded-field border border-pine-500 bg-white px-3 py-2 text-ink-900 focus-visible:outline-offset-0 aria-invalid:border-red-300"
			if s.nameError() {
				aria-invalid="true"
				aria-describedby="trip-name-error"
				autofocus
			}
		/>
	</div>
}

// startTripMembers is the member prompt: everyone unticked, so a trip stays
// private unless the owner picks people. Select all is a script shortcut.
templ startTripMembers(s StartTrip) {
	<fieldset
		class="basis-full min-w-0 rounded-card border border-pine-500 bg-pine-900 p-3 my-1"
		aria-labelledby="start-trip-members-label"
		if s.MemberError {
			aria-describedby="start-trip-members-hint trip-name-error"
		} else {
			aria-describedby="start-trip-members-hint"
		}
		x-data="{ picked: 0, total: 0, count() { const boxes = [...this.$root.querySelectorAll('input[name=member]')]; this.total = boxes.length; this.picked = boxes.filter(box => box.checked).length }, toggleAll() { const all = this.picked < this.total; this.$root.querySelectorAll('input[name=member]').forEach(box => box.checked = all); this.count() } }"
		x-init="count()"
		x-on:change="count()"
	>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<p id="start-trip-members-label" class="font-bold">Share this trip with list members?</p>
			<button
				type="button"
				class="btn btn-secondary btn-sm"
				x-cloak
				x-on:click="toggleAll()"
				x-text="picked < total ? 'Select all' : 'Clear all'"
			>Select all</button>
		</div>
		<p id="start-trip-members-hint" class="text-sm text-pine-100 mt-1 mb-2">People you tick can open this trip and mark gear packed. Leave everyone unticked to keep it private.</p>
		<div class="grid gap-1">
			for i, member := range s.Members {
				<label class="flex items-center gap-3 min-h-11 rounded-field border border-transparent px-2 py-1 cursor-pointer has-checked:border-pine-100 has-checked:bg-pine-700">
					<input
						type="checkbox"
						name="member"
						value={ member.Subject }
						checked?={ s.Chosen[member.Subject] }
						class="shrink-0 accent-pine-500"
						if i == 0 && !s.nameError() {
							autofocus
						}
					/>
					<span class="grid min-w-0">
						<span class="font-bold wrap-anywhere">{ memberName(member) }</span>
						if member.Email != "" {
							<span class="text-sm text-pine-100 wrap-anywhere">{ member.Email }</span>
						}
					</span>
				</label>
			}
		</div>
	</fieldset>
}

func startTripPromptPath(listID string) templ.SafeURL {
	return templ.SafeURL("/packing-lists/" + listID + "/start")
}

// nameError reports whether the error is about the trip name, which then takes focus.
func (s StartTrip) nameError() bool {
	return len(s.Errors) > 0 && !s.MemberError
}

// StartTripPage is the start-trip form without scripts: the member prompt, or
// a rejected trip name.
templ StartTripPage(s StartTrip, csrfToken string) {
	@Layout("Start trip", csrfToken) {
		<section class="card card-brand p-4 sm:p-6">
			<h1>Start trip</h1>
			<p class="text-pine-100 mb-3">From { s.List.Name }</p>
			@StartTripForm(s, csrfToken)
			if !s.Prompt {
				<p class="mt-4"><a class="text-white" href={ "/packing-lists/" + s.List.ID }>Back to the list</a></p>
			}
		</section>
	}
}

// PreparationTaskRow is one task on the reusable list. Normally it is a
// checklist row that toggles done like a packing row; while the card is in
// edit mode it becomes a rename field with Save and Remove. Everything posts
// to the existing preparation endpoint. The server seeds edit mode, so the
// hidden variant is cloaked until Alpine starts instead of flashing.
templ PreparationTaskRow(list packing.PackingList, task packing.PreparationTask, csrfToken string, editing bool, focus string, next string) {
	<li class="border-b border-sand-100 last:border-b-0">
		<form
			class="pack-form w-full [&.htmx-request]:opacity-60"
			method="post"
			action={ "/packing-lists/" + list.ID + "/preparation/edit" }
			{ preparationSwap(list)... }
			x-show="!editing"
			x-cloak?={ editing }
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			<input type="hidden" name="revision" value={ list.Revision() }/>
			<input type="hidden" name="taskId" value={ task.ID }/>
			<input type="hidden" name="name" value={ task.Name }/>
			<input type="hidden" name="scope" value={ task.Scope }/>
			<input type="hidden" name="action" value="save"/>
			<input type="hidden" name="done" value={ strconv.FormatBool(!task.Done) }/>
			<button id={ "task-done-" + task.ID } type="submit" class={ "pack-row py-2", templ.KV("packed", task.Done) } aria-pressed={ strconv.FormatBool(task.Done) } aria-label={ "Toggle done for " + task.Name }>
				<span class="tick" aria-hidden="true"></span>
				<span class="pack-name">{ task.Name }</span>
				<span class="pack-action">
					if task.Done {
						Undo
					} else {
						Mark done
					}
				</span>
			</button>
		</form>
		<form
			class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2 py-3 sm:grid-cols-[minmax(0,1fr)_11rem_auto_auto] [&.htmx-request]:opacity-60"
			method="post"
			action={ "/packing-lists/" + list.ID + "/preparation/edit" }
			{ preparationSwap(list)... }
			x-show="editing"
			x-cloak?={ !editing }
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			<input type="hidden" name="revision" value={ list.Revision() }/>
			<input type="hidden" name="taskId" value={ task.ID }/>
			<input type="hidden" name="action" value="save"/>
			<input type="hidden" name="done" value={ strconv.FormatBool(task.Done) }/>
			<input type="hidden" name="editing" x-bind:value="editing"/>
			@Field(TextField{
				ID:        "task-" + task.ID,
				Name:      "name",
				Label:     "Task name",
				Value:     task.Name,
				HideLabel: true,
				Attrs:     templ.Attributes{"required": true, "maxlength": "200", "autofocus": focus == "task-"+task.ID},
			})
			<div class="max-sm:order-last max-sm:w-48">
				@ScopeSelect("scope", "task-scope-"+task.ID, task.Scope, false, true)
			</div>
			<button class="btn btn-secondary btn-sm min-h-11">Save</button>
			<button type="button" class="btn btn-secondary text-red-700 btn-sm max-sm:order-last justify-self-end sm:min-h-11" { removeTaskAttrs(list, next)... }>Remove</button>
		</form>
	</li>
}

// AddItemForm adds an item at the top of the gear sheet: the name and Add
// item on one line, then its category and who it is for. htmx swaps it for a
// fresh form after an add, or for the form with its errors, and swaps the
// gear out of band; focus puts the cursor back in the name field. Without
// scripts it posts normally and redirects.
templ AddItemForm(form packing.CreateItemForm, csrfToken string, focus bool) {
	<form
		id="add-item"
		action={ form.Action }
		method="POST"
		hx-post={ form.Action }
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="this:drop"
		class="grid gap-2 [&.htmx-request]:opacity-60"
	>
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<input type="hidden" name="revision" value={ form.Revision }/>
		<div class="flex items-center gap-2">
			<div class="min-w-0 flex-auto">
				@Field(TextField{
					ID:          "item-name-new",
					Name:        "name",
					Label:       "Item name",
					Value:       form.Name,
					Placeholder: "Like a headlamp",
					HideLabel:   true,
					Invalid:     form.NameHasError(),
					Attrs:       templ.Attributes{"autofocus": focus},
				})
			</div>
			<button type="submit" class="btn btn-primary shrink-0">{ form.SubmitButtonText }</button>
		</div>
		<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2">
			<div class="min-w-0">
				<label for="item-category-new" class="sr-only">Category</label>
				@CategoryPicker("item-category-new", "item-category-new-options", form.Category, "Category", form.Categories)
			</div>
			@ScopeSelect("scope", "item-scope-new", form.Scope, false, true)
		</div>
		if len(form.Error) > 0 {
			@ErrorBanner(form.Error)
		}
	</form>
}

// ItemFields is the name, category and scope set of the edit forms. The name
// takes focus, so an inline Edit or a rejected save lands the keyboard there.
// stacked sets the fields for the inline edit row: the name on its own line,
// category and who it is for beside each other.
templ ItemFields(form packing.CreateItemForm, suffix string, stacked bool) {
	<input type="hidden" name="revision" value={ form.Revision }/>
	<div class={ "grid", templ.KV("gap-3 mb-3 grid-cols-[minmax(0,1fr)_auto]", stacked), templ.KV("gap-4 mb-4 sm:grid-cols-[1fr_1fr]", !stacked) }>
		<div class={ templ.KV("col-span-2", stacked) }>
			@Field(TextField{
				ID:          "item-name-" + suffix,
				Name:        "name",
				Label:       "Name",
				Value:       form.Name,
				Placeholder: "Headlamp",
				Invalid:     form.NameHasError(),
				Attrs:       templ.Attributes{"autofocus": true},
			})
		</div>
		<div class="min-w-0">
			<label for={ "item-category-" + suffix } class="label">Category</label>
			@CategoryPicker("item-category-"+suffix, "item-category-"+suffix+"-options", form.Category, "Pick or type one", form.Categories)
		</div>
		@ScopeSelect("scope", "item-scope-"+suffix, form.Scope, false, false)
	</div>
}

// ItemRow is one item in the gear: its name, a tag when it is packed for each
// person, and Edit, which swaps the row for ItemEditRow in place.
templ ItemRow(listID string, item packing.PackingItem) {
	@itemRow(listID, item, false, false)
}

// FocusedItemRow is the row htmx swaps back after Save or Cancel. Its Edit
// link takes focus, so the keyboard stays on the item instead of the page.
templ FocusedItemRow(listID string, item packing.PackingItem) {
	@itemRow(listID, item, true, false)
}

templ itemRow(listID string, item packing.PackingItem, focusEdit bool, preserve bool) {
	<li
		class="item-row flex-nowrap min-h-12 px-4"
		id={ "item-" + item.ID }
		if preserve {
			hx-preserve
		}
	>
		<span class="flex-auto min-w-0 font-semibold wrap-anywhere">{ item.Name }</span>
		if item.Scope == "person" {
			<span class="tag tag-quiet">For each person</span>
		}
		<a
			id={ "edit-" + item.ID }
			class="btn btn-ghost btn-sm shrink-0"
			href={ "/packing-lists/" + listID + "/items/" + item.ID + "/edit" }
			if focusEdit {
				autofocus
			}
			hx-get={ "/packing-lists/" + listID + "/items/" + item.ID + "/edit" }
			hx-target="closest li"
			hx-swap="outerHTML"
		>Edit</a>
	</li>
}

// ItemEditRow replaces ItemRow while an item is being edited. Delete item sits
// here rather than on the resting row: it removes the row and
// static/removal-focus.js moves focus to the next row's Edit.
templ ItemEditRow(listID string, itemID string, form packing.CreateItemForm) {
	<li class="block px-4 py-3 bg-sand-50 border-b border-sand-100 last:border-b-0 [&.htmx-request]:opacity-60" id={ "item-" + itemID }>
		<form
			class="w-full"
			action={ form.Action }
			method="POST"
			hx-post={ form.Action }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-sync="this:drop"
		>
			@ItemFields(form, itemID, true)
			if len(form.Error) > 0 {
				@ErrorBanner(form.Error)
			}
			<div class="flex flex-wrap items-center gap-2">
				<button
					type="button"
					class="btn btn-ghost btn-sm text-red-700 mr-auto"
					hx-delete={ "/packing-lists/" + listID + "/remove-item/" + itemID }
					hx-headers={ templ.JSONString(map[string]string{"X-Camplist-Revision": form.Revision}) }
					hx-target="closest li"
					hx-swap="delete"
					hx-indicator="closest li"
					hx-sync="closest li:drop"
					hx-confirm="Delete this item?"
					data-confirm-action="Delete item"
				>Delete item</button>
				<a
					class="btn btn-ghost btn-sm"
					href={ "/packing-lists/" + listID }
					hx-get={ "/packing-lists/" + listID + "/items/" + itemID }
					hx-target="closest li"
					hx-swap="outerHTML"
				>Cancel</a>
				<button type="submit" class="btn btn-primary btn-sm">{ form.SubmitButtonText }</button>
			</div>
		</form>
	</li>
}

// EditItemPage is the fallback for editing an item without scripts.
templ EditItemPage(list packing.PackingList, form packing.CreateItemForm, csrfToken string) {
	@Layout("Edit item", csrfToken) {
		<section class="max-w-[560px]">
			@PageHead(PageHeading{
				Title:     "Edit item",
				Meta:      "On " + list.Name,
				BackHref:  "/packing-lists/" + list.ID,
				BackLabel: "Packing list",
			})
			<div class="card">
				<form action={ form.Action } method="POST" hx-boost="true">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					@ItemFields(form, "edit", false)
					if len(form.Error) > 0 {
						@ErrorBanner(form.Error)
					}
					<div class="flex flex-wrap items-center justify-end gap-2 max-sm:*:flex-auto">
						<a class="btn btn-secondary" href={ "/packing-lists/" + list.ID }>Cancel</a>
						<button type="submit" class="btn btn-primary">{ form.SubmitButtonText }</button>
					</div>
				</form>
			</div>
		</section>
	}
}

// ScopeSelect is the "Who is this for?" field on item, task and trip entry
// forms. personal adds "Just for me", which only a trip offers; hideLabel
// keeps the label for screen readers in compact rows.
templ ScopeSelect(name string, id string, scope string, personal bool, hideLabel bool) {
	@SelectField(id, name, "Who is this for?", hideLabel, scopeOptions(personal), scopeValue(scope))
}
