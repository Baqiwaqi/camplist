package views

import "camplist/internal/packing"

templ NewPackingListPage(form packing.CreatePackingListForm, csrfToken string) {
	@Layout("New list", csrfToken) {
		<section class="max-w-[560px]">
			@PageHead(PageHeading{
				Title:     "Start a new list",
				Meta:      "Save your regular gear here and reuse it for future trips.",
				BackHref:  "/packing-lists",
				BackLabel: "Packing lists",
			})
			<div class="card">
				@PackingListForm(form, csrfToken)
			</div>
		</section>
	}
}

templ EditPackingListPage(listName string, form packing.CreatePackingListForm, csrfToken string) {
	@Layout("Edit list", csrfToken) {
		<section class="max-w-[560px]">
			@PageHead(PageHeading{
				Title:     "Edit list",
				Meta:      "Change the name or description of " + listName + ". Your items and trips stay as they are.",
				BackHref:  "/packing-lists",
				BackLabel: "Packing lists",
			})
			<div class="card">
				@PackingListForm(form, csrfToken)
			</div>
		</section>
	}
}

templ PackingListForm(form packing.CreatePackingListForm, csrfToken string) {
	<form method="post" action={ form.Action } hx-boost="true">
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<input type="hidden" name="revision" value={ form.Revision }/>
		<div class="mb-4">
			@Field(TextField{ID: "name", Name: "name", Label: "Name", Value: form.Name, Placeholder: "Camping", Invalid: form.NameHasError()})
		</div>
		<div class="mb-4">
			@Field(TextField{ID: "description", Name: "description", Label: "Description", Value: form.Description, Placeholder: "A short description of your list", Multiline: true})
		</div>
		if len(form.Error) > 0 {
			@ErrorBanner(form.Error)
		}
		<div class="flex flex-wrap items-center justify-end gap-2 max-sm:*:flex-auto">
			<a class="btn btn-secondary" href="/">Cancel</a>
			<button type="submit" class="btn btn-primary">{ form.SubmitButtonText }</button>
		</div>
	</form>
}
