package views

import (
	"camplist/internal/auth"
	"camplist/internal/packing"
	"strconv"
	"time"
)

templ PackingDetails(name string, list packing.PackingList, form packing.CreateItemForm, csrfToken string) {
	@Layout(name, csrfToken) {
		<section>
			<div class="card card-brand p-4 sm:p-6 mb-6">
				<div class="flex flex-wrap justify-between items-start gap-4 max-sm:flex-col max-sm:items-stretch">
					<div class="min-w-0 max-sm:flex-none sm:flex-[1_1_320px]">
						<p class="text-xs font-bold tracking-eyebrow uppercase text-pine-100 mb-2">Packing list</p>
						<h1>{ list.Name }</h1>
						if list.Description != "" {
							<p class="text-xl max-w-[48ch] mb-3">{ list.Description }</p>
						}
						<p class="text-sm text-pine-100">{ itemSummary(list.Items) }</p>
					</div>
					<div class="flex flex-wrap items-end gap-2 sm:pt-6">
						<form method="post" action="/packing-lists/start-session" hx-post="/packing-lists/start-session" class="flex flex-wrap items-end gap-2 max-sm:w-full">
							<input type="hidden" name="_csrf" value={ csrfToken }/><input type="hidden" name="listId" value={ list.ID }/>
							<div class="grid gap-1 max-sm:w-full"><label for="trip-name" class="text-sm font-bold text-pine-100">Trip name</label><input id="trip-name" name="name" value={ list.Name + " – " + time.Now().Format("Jan 2, 2006") } required maxlength="200" class="min-h-11 w-64 max-w-full max-sm:w-full rounded-sm border border-pine-500 bg-white px-3 py-2 text-ink-900 focus-visible:outline-offset-0"/></div>
							<button class="btn btn-accent max-sm:flex-auto">Start trip</button>
						</form>
						@PageMenu("More") {
							@MenuLink("/packing-lists/"+list.ID+"/edit", "Edit list")
							@MenuLink("/sharing/packing-list/"+list.ID, "Sharing")
							if list.UserID == auth.Subject(ctx) {
								@MenuSeparator()
								@MenuButton("Delete list", true, confirmDelete("/packing-lists/"+list.ID, csrfToken, "Delete this list?", "Delete list", "Trips you already started keep their own copy."))
							}
						}
					</div>
				</div>
			</div>
			<p class="text-muted max-w-[60ch]">Starting a trip copies this list. Your reusable list stays unchanged as you pack.</p>
		</section>
		<section class="mt-8">
			<datalist id="list-categories">
				for _, category := range categories(list.Items,2000) {
					<option value={ category }></option>
				}
			</datalist>
			@ListItemForm(form, csrfToken)
		</section>
		<section class="mt-8">
			<div class="card">
				if len(list.Items) == 0 {
					<p class="text-muted mb-3">No items yet. Add your first item above.</p>
				}
				<ul class="columns-[17rem] gap-x-8">
					for _, item := range list.Items {
						@ItemRow(list.ID, item, csrfToken)
					}
				</ul>
			</div>
		</section>
		<section class="mt-8">
			<section class="card" x-data="{ editing: false }">
				<div class="flex flex-wrap justify-between items-start gap-4 max-sm:flex-col">
					<div class="min-w-0 max-sm:flex-none sm:flex-[1_1_240px]">
						<h2>Prepare before your next trip</h2>
						<p class="text-muted mb-3">Tasks from trip reviews and your own notes. Mark one done once it is handled; done tasks start every new trip as handled.</p>
					</div>
					if len(list.Tasks) > 0 {
						<div class="flex flex-wrap items-center gap-2 max-sm:w-full">
							<button type="button" class="btn btn-secondary btn-sm" x-on:click="editing = !editing" x-bind:aria-pressed="editing" x-text="editing ? 'Done editing' : 'Edit tasks'">Edit tasks</button>
						</div>
					}
				</div>
				if len(list.Tasks) == 0 {
					<p class="text-muted mb-3">No tasks yet.</p>
				} else {
					@PreparationTasks(list, csrfToken)
				}
				<form class="flex flex-wrap items-end gap-3 my-3" method="post" action={ "/packing-lists/" + list.ID + "/preparation/edit" }>
					<input type="hidden" name="_csrf" value={ csrfToken }/><input type="hidden" name="revision" value={ list.Revision() }/>
					<div class="grid gap-1 grow basis-56"><label class="sr-only" for="new-task">New preparation task</label><input id="new-task" name="name" placeholder="Add a task, like buying fuel" required maxlength="200" class="w-full min-h-11 rounded-sm border border-sand-300 bg-white px-3 py-2 focus-visible:border-pine-700 focus-visible:outline-offset-0"/></div>
					<div class="grid gap-1"><label class="sr-only" for="new-task-scope">Who is this for?</label>@ScopeSelect("scope", "new-task-scope", "", false)</div>
					<button class="btn btn-secondary">Add task</button>
				</form>
				<p class="text-muted">Doing a task packs nothing: buying fuel does not mark your stove as packed.</p>
				if len(list.Changes) > 0 {
					<h3>Improvements from trip reviews</h3>
					<ul>
						for _, change := range list.Changes {
							<li class="py-2 border-b border-sand-100 font-bold last:border-b-0">{ change }</li>
						}
					</ul>
				}
			</section>
		</section>
	}
}

// PreparationTasks is the task list on the reusable list page. Mark done swaps
// only this list, because every row carries the list revision the toggle
// just changed; static/revision.js advances the other controls on the page.
templ PreparationTasks(list packing.PackingList, csrfToken string) {
	<ul id="preparation-tasks">
		for _, task := range list.Tasks {
			@PreparationTaskRow(list, task, csrfToken)
		}
	</ul>
}

// PreparationTaskRow is one task on the reusable list. Normally it is a
// checklist row that toggles done like a packing row; while the card is in
// edit mode it becomes a rename field with Save and Remove. Everything posts
// to the existing preparation endpoint.
templ PreparationTaskRow(list packing.PackingList, task packing.PreparationTask, csrfToken string) {
	<li class="item-row py-0">
		<form
			class="pack-form w-full"
			method="post"
			action={ "/packing-lists/" + list.ID + "/preparation/edit" }
			hx-post={ "/packing-lists/" + list.ID + "/preparation/edit" }
			hx-target="#preparation-tasks"
			hx-swap="outerHTML"
			hx-sync="#preparation-tasks:drop"
			x-show="!editing"
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			<input type="hidden" name="revision" value={ list.Revision() }/>
			<input type="hidden" name="taskId" value={ task.ID }/>
			<input type="hidden" name="name" value={ task.Name }/>
			<input type="hidden" name="scope" value={ task.Scope }/>
			<input type="hidden" name="action" value="save"/>
			<input type="hidden" name="done" value={ strconv.FormatBool(!task.Done) }/>
			<button id={ "task-done-" + task.ID } type="submit" class={ "pack-row", templ.KV("packed", task.Done) } aria-pressed={ strconv.FormatBool(task.Done) } aria-label={ "Toggle done for " + task.Name }>
				<span class="tick" aria-hidden="true"></span>
				<span class="pack-name">{ task.Name }</span>
				<span class="pack-action">
					if task.Done {
						Undo
					} else {
						Mark done
					}
				</span>
			</button>
		</form>
		<form class="flex flex-wrap items-end gap-3 my-2 w-full" method="post" action={ "/packing-lists/" + list.ID + "/preparation/edit" } x-show="editing" x-cloak>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			<input type="hidden" name="revision" value={ list.Revision() }/>
			<input type="hidden" name="taskId" value={ task.ID }/>
			<input type="hidden" name="action" value="save"/>
			<input type="hidden" name="done" value={ strconv.FormatBool(task.Done) }/>
			<div class="grid gap-1 grow basis-56"><label class="sr-only" for={ "task-" + task.ID }>Task name</label><input id={ "task-" + task.ID } name="name" value={ task.Name } required maxlength="200" class="w-full min-h-11 rounded-sm border border-sand-300 bg-white px-3 py-2 focus-visible:border-pine-700 focus-visible:outline-offset-0"/></div>
			<div class="grid gap-1"><label class="sr-only" for={ "task-scope-" + task.ID }>Who is this for?</label>@ScopeSelect("scope", "task-scope-"+task.ID, task.Scope, false)</div>
			<button class="btn btn-primary btn-sm">Save</button>
			<button type="button" class="btn btn-danger btn-sm" { removeTaskAttrs(list, task, csrfToken)... }>Remove</button>
		</form>
	</li>
}

// ListItemForm is the compact add form on the details page: the name with the
// add button beside it, and category and scope folded behind a toggle that
// opens by itself when the form comes back with either one filled in.
templ ListItemForm(form packing.CreateItemForm, csrfToken string) {
	<h2 class="mb-3">Add an item</h2>
	<div class="card">
		<form action={ form.Action } method="POST" hx-boost="true">
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			<input type="hidden" name="revision" value={ form.Revision }/>
			<div class="flex items-center gap-2">
				<label for="item-name-new" class="sr-only">Item name</label>
				<input
					type="text"
					id="item-name-new"
					name="name"
					placeholder="Like a headlamp"
					value={ form.Name }
					class="min-w-0 flex-1 min-h-11 rounded-sm border border-sand-300 bg-white px-3 py-2 focus-visible:border-pine-700 focus-visible:outline-offset-0 aria-invalid:border-red-300"
					if form.NameHasError() {
						aria-invalid="true"
					}
				/>
				<button type="submit" class="btn btn-primary min-h-11 shrink-0">{ form.SubmitButtonText }</button>
			</div>
			if len(form.Error) > 0 {
				<div class="mt-3">
					@ErrorBanner(form.Error)
				</div>
			}
			<details class="mt-1" open?={ form.Category != "" || (form.Scope != "" && form.Scope != "shared") }>
				<summary class="w-fit cursor-pointer py-3 text-sm font-bold text-pine-700">Category and who it's for</summary>
				<div class="grid gap-3 pb-1 sm:grid-cols-2">
					<div class="grid gap-1">
						<label for="item-category-new" class="text-sm font-bold">Category</label>
						<input type="text" id="item-category-new" name="category" list="list-categories" placeholder="Light" value={ form.Category } class="w-full min-h-11 rounded-sm border border-sand-300 bg-white px-3 py-2 focus-visible:border-pine-700 focus-visible:outline-offset-0"/>
					</div>
					<div class="grid gap-1">
						<label for="item-scope-new" class="text-sm font-bold">Who is this for?</label>
						@ScopeSelect("scope", "item-scope-new", form.Scope, false)
					</div>
				</div>
			</details>
		</form>
	</div>
}

// ItemFields is the name and category pair shared by the add and edit forms.
// stacked puts the fields under each other for the inline edit row.
templ ItemFields(form packing.CreateItemForm, suffix string, stacked bool) {
	<input type="hidden" name="revision" value={ form.Revision }/>
	<div class={ "grid", templ.KV("gap-3 mb-3", stacked), templ.KV("gap-4 mb-4 sm:grid-cols-[1fr_1fr]", !stacked) }>
		<div class="grid gap-1">
			<label for={ "item-name-" + suffix } class="text-sm font-bold">Name</label>
			<input
				type="text"
				id={ "item-name-" + suffix }
				name="name"
				placeholder="Headlamp"
				value={ form.Name }
				class="w-full min-h-11 rounded-sm border border-sand-300 bg-white px-3 py-2 focus-visible:border-pine-700 focus-visible:outline-offset-0 aria-invalid:border-red-300"
				if form.NameHasError() {
					aria-invalid="true"
				}
			/>
		</div>
		<div class="grid gap-1">
			<label for={ "item-category-" + suffix } class="text-sm font-bold">Category</label>
			<input type="text" id={ "item-category-" + suffix } name="category" list="list-categories" placeholder="Light" value={ form.Category } class="w-full min-h-11 rounded-sm border border-sand-300 bg-white px-3 py-2 focus-visible:border-pine-700 focus-visible:outline-offset-0"/>
		</div>
		<div class="grid gap-1">
			<label for={ "item-scope-" + suffix } class="text-sm font-bold">Who is this for?</label>
			@ScopeSelect("scope", "item-scope-"+suffix, form.Scope, false)
		</div>
	</div>
}

// ItemRow is one item on the details page. Edit swaps it for ItemEditRow in place.
templ ItemRow(listID string, item packing.PackingItem, csrfToken string) {
	<li class="item-row break-inside-avoid" id={ "item-" + item.ID }>
		<span class="font-bold min-w-0 wrap-anywhere">{ item.Name }</span>
		if item.Category != "" {
			<span class="inline-block whitespace-nowrap text-xs font-bold tracking-tag uppercase text-pine-700 bg-pine-100 px-2 py-0.5 rounded-full">{ item.Category }</span>
		}
		<div class="flex flex-wrap items-center gap-2 ml-auto">
			<a
				class="btn btn-secondary btn-sm"
				href={ "/packing-lists/" + listID + "/items/" + item.ID + "/edit" }
				hx-get={ "/packing-lists/" + listID + "/items/" + item.ID + "/edit" }
				hx-target="closest li"
				hx-swap="outerHTML"
			>Edit</a>
			<button
				class="btn btn-danger btn-sm"
				hx-delete={ "/packing-lists/" + listID + "/remove-item/" + item.ID }
				hx-headers={ templ.JSONString(map[string]string{"X-CSRF-Token": csrfToken, "X-Camplist-Revision": item.SourceRevision}) }
				hx-confirm="Delete this item?"
				data-confirm-action="Delete item"
			>Delete</button>
		</div>
	</li>
}

// ItemEditRow replaces ItemRow while an item is being edited: the row becomes
// a stacked form inside its column.
templ ItemEditRow(listID string, itemID string, form packing.CreateItemForm, csrfToken string) {
	<li class="item-row block break-inside-avoid" id={ "item-" + itemID }>
		<form
			class="w-full"
			action={ form.Action }
			method="POST"
			hx-post={ form.Action }
			hx-target="closest li"
			hx-swap="outerHTML"
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			@ItemFields(form, itemID, true)
			if len(form.Error) > 0 {
				@ErrorBanner(form.Error)
			}
			<div class="flex flex-wrap items-center justify-end gap-2 max-sm:*:flex-auto">
				<a
					class="btn btn-secondary btn-sm"
					href={ "/packing-lists/" + listID }
					hx-get={ "/packing-lists/" + listID + "/items/" + itemID }
					hx-target="closest li"
					hx-swap="outerHTML"
				>Cancel</a>
				<button type="submit" class="btn btn-primary btn-sm">{ form.SubmitButtonText }</button>
			</div>
		</form>
	</li>
}

// EditItemPage is the fallback for editing an item without scripts.
templ EditItemPage(list packing.PackingList, form packing.CreateItemForm, csrfToken string) {
	@Layout("Edit item", csrfToken) {
		<datalist id="list-categories">
			for _, category := range categories(list.Items,2000) {
				<option value={ category }></option>
			}
		</datalist>
		<section class="max-w-[560px]">
			<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700 mb-2">{ list.Name }</p>
			<h1>Edit item</h1>
			<div class="card">
				<form action={ form.Action } method="POST" hx-boost="true">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					@ItemFields(form, "edit", false)
					if len(form.Error) > 0 {
						@ErrorBanner(form.Error)
					}
					<div class="flex flex-wrap items-center justify-end gap-2 max-sm:*:flex-auto">
						<a class="btn btn-secondary" href={ "/packing-lists/" + list.ID }>Cancel</a>
						<button type="submit" class="btn btn-primary">{ form.SubmitButtonText }</button>
					</div>
				</form>
			</div>
		</section>
	}
}

templ ScopeSelect(name string, id string, scope string, personal bool) {
	<select name={ name } id={ id } aria-label="Who is this for?" class="w-full min-h-11 rounded-sm border border-sand-300 bg-white px-2 py-2 font-normal">
		<option value="shared" selected?={ scope=="" || scope=="shared" }>Shared</option>
		if personal {
			<option value="mine" selected?={ scope=="mine" }>Just for me</option>
		}
		<option value="person" selected?={ scope=="person" }>For each person</option>
	</select>
}
