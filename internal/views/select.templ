package views

import "strconv"

// SelectOption is one choice in a Select.
type SelectOption struct {
	Value string
	Label string
}

// Select is a Pines UI style dropdown: a combobox button and a scrollable
// listbox, driven by Alpine.data("select") in static/select.js. The native
// <select> stays in the form and carries the value, so a plain post, an htmx
// swap and a re-rendered error all keep the choice; without JavaScript the
// layout's noscript style shows the native control instead. The popup toggles
// the hidden attribute rather than x-show: htmx settles style and class on
// same-id elements after a swap, which would undo an inline display. Select
// is the stacked field of a standalone form, with room above and below.
templ Select(id string, name string, label string, options []SelectOption, selected string) {
	@selectField(id, name, label, false, "my-3 max-w-[34rem]", options, selected)
}

// SelectField is the same control without outer spacing, for form grids and
// inline rows. hideLabel keeps the label for screen readers only.
templ SelectField(id string, name string, label string, hideLabel bool, options []SelectOption, selected string) {
	@selectField(id, name, label, hideLabel, "min-w-44", options, selected)
}

templ selectField(id string, name string, label string, hideLabel bool, class string, options []SelectOption, selected string) {
	<div class={ "grid gap-1", class } x-data="select" x-on:click.outside="close(false)" x-on:focusout="leave($event)">
		<label id={ id + "-label" } for={ id } class={ "block text-sm font-bold", templ.KV("sr-only", hideLabel) } x-on:click.prevent="$refs.trigger.focus()">{ label }</label>
		<select id={ id } name={ name } x-ref="native" tabindex="-1" class="select-native w-full min-h-11 px-2 py-2 rounded-field border border-sand-300 bg-white font-normal">
			for _, option := range options {
				<option value={ option.Value } selected?={ option.Value == selected }>{ option.Label }</option>
			}
		</select>
		<div class="relative">
			<button
				type="button"
				id={ id + "-trigger" }
				x-ref="trigger"
				class="select-trigger"
				role="combobox"
				aria-haspopup="listbox"
				aria-labelledby={ id + "-label" }
				aria-controls={ id + "-listbox" }
				aria-expanded="false"
				x-bind:aria-expanded="open"
				x-bind:aria-activedescendant={ "open ? '" + id + "-option-' + active : null" }
				x-on:click="toggle()"
				x-on:keydown="key($event)"
			>
				<span class="min-w-0 truncate" x-text="label()">{ selectedLabel(options, selected) }</span>
			</button>
			<ul
				id={ id + "-listbox" }
				x-ref="listbox"
				role="listbox"
				aria-labelledby={ id + "-label" }
				class="popup select-popup"
				x-bind:class="up && 'select-popup-up'"
				hidden
				x-bind:hidden="!open"
				x-on:mousedown.prevent
			>
				for i, option := range options {
					<li
						id={ id + "-option-" + strconv.Itoa(i) }
						role="option"
						class="option"
						aria-selected={ strconv.FormatBool(option.Value == selected) }
						x-bind:aria-selected={ "selected === " + strconv.Itoa(i) }
						x-bind:data-active={ "active === " + strconv.Itoa(i) }
						x-on:mousemove={ "active = " + strconv.Itoa(i) }
						x-on:click={ "choose(" + strconv.Itoa(i) + ")" }
					>{ option.Label }</li>
				}
			</ul>
		</div>
	</div>
}

func selectedLabel(options []SelectOption, selected string) string {
	for _, option := range options {
		if option.Value == selected {
			return option.Label
		}
	}
	if len(options) > 0 {
		return options[0].Label
	}
	return ""
}

// entryKindOptions are the kinds of thing a trip entry adds.
var entryKindOptions = []SelectOption{
	{Value: "", Label: "Packing item"},
	{Value: "task", Label: "Before you go task"},
}

// scopeOptions lists who an item or task is for. personal adds "Just for
// me", which trip entries offer and reusable lists do not.
func scopeOptions(personal bool) []SelectOption {
	options := []SelectOption{{Value: "shared", Label: "Shared"}}
	if personal {
		options = append(options, SelectOption{Value: "mine", Label: "Just for me"})
	}
	return append(options, SelectOption{Value: "person", Label: "For each person"})
}

// scopeValue treats an unset scope as shared, the first option.
func scopeValue(scope string) string {
	if scope == "" {
		return "shared"
	}
	return scope
}
