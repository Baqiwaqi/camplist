package views

templ Login(title string) {
	@Shell(title) {
		<div class="grid md:grid-cols-2 md:min-h-dvh">
			<section class="bg-pine-700 text-white flex flex-col gap-6 px-4 py-6 md:gap-8 md:p-8">
				<a class="self-start inline-flex items-center gap-2 text-white no-underline font-bold text-xl focus-visible:outline-white" href="/">
					<img src="/static/logomark-white.svg" alt="" width="28" height="28"/>
					Camplist
				</a>
				<div class="my-auto">
					<h1 class="text-[clamp(2.5rem,1.5rem+4vw,3.5rem)] leading-none mb-4">Pack once.<br/>Go every weekend.</h1>
					<p class="text-xl max-w-[380px] text-pine-100">Keep your camping kit as a list, start a session for each trip, and get out the door faster than last time.</p>
				</div>
			</section>
			<section class="grid place-items-center mt-8 px-4 pt-6 pb-8 md:py-8" aria-labelledby="login-heading">
				<div class="w-full max-w-[340px]">
					<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700 mb-2">Sign in</p>
					<h2 id="login-heading" class="text-[clamp(2rem,1.25rem+3vw,2.75rem)] mb-4">Let's get packing.</h2>
					<a class="btn btn-secondary btn-lg w-full" href="/auth/login">Sign in with Google</a>
					<p class="text-muted text-sm mt-4">Your lists and sessions stay with your Google account.</p>
				</div>
			</section>
		</div>
	}
}
