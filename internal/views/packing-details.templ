package views

import (
	"camplist/internal/packing"
	"time"
)

templ PackingDetails(name string, list packing.PackingList, form packing.CreateItemForm, csrfToken string) {
	@Layout(name, csrfToken) {
		<section>
			<div class="card card-brand hero">
				<div class="page-head">
					<div>
						<p class="eyebrow">Packing list</p>
						<h1>{ list.Name }</h1>
						if list.Description != "" {
							<p class="hero-lede">{ list.Description }</p>
						}
						<p class="hero-meta">{ itemSummary(list.Items) }</p>
					</div>
					<div class="actions">
						<a class="btn btn-secondary" href={ "/sharing/packing-list/" + list.ID }>Sharing</a>
						<a class="btn btn-secondary" href={ "/packing-lists/" + list.ID + "/edit" }>Edit</a>
						<form method="post" action="/packing-lists/start-session" hx-post="/packing-lists/start-session">
							<input type="hidden" name="_csrf" value={ csrfToken }/><input type="hidden" name="listId" value={ list.ID }/>
							<div class="field"><label for="trip-name">Trip name</label><input id="trip-name" name="name" value={ list.Name + " – " + time.Now().Format("Jan 2, 2006") } required maxlength="200"/></div>
							<button class="btn btn-accent">Start trip</button>
						</form>
					</div>
				</div>
			</div>
			<p class="muted lede">Starting a session copies this list. Your reusable list stays unchanged as you pack.</p>
		</section>
		<section>
			<datalist id="list-categories">
				for _, category := range categories(list.Items,2000) {
					<option value={ category }></option>
				}
			</datalist>
			@ListItemForm(form, csrfToken)
		</section>
		<section>
			<div class="card">
				if len(list.Items) == 0 {
					<p class="muted">No items yet. Add your first item above.</p>
				}
				<ul class="item-list columns">
					for _, item := range list.Items {
						@ItemRow(list.ID, item, csrfToken)
					}
				</ul>
			</div>
		</section>
		<section>
			<section class="card">
				<h2>Prepare before your next trip</h2>
				for _, task := range list.Tasks {
					<form class="task-row" method="post" action={ "/packing-lists/" + list.ID + "/preparation/edit" }>
						<input type="hidden" name="_csrf" value={ csrfToken }/><input type="hidden" name="revision" value={ list.Revision() }/><input type="hidden" name="taskId" value={ task.ID }/>
						<label class="sr-only" for={ "task-" + task.ID }>Preparation task</label><input id={ "task-" + task.ID } name="name" value={ task.Name } required maxlength="200"/>
						@ScopeSelect("scope", "task-scope-"+task.ID, task.Scope, false)
						<button class="btn btn-secondary btn-sm" name="action" value="save">Save task</button><button
	class="btn btn-danger btn-sm"
	name="action"
	value="remove"
	formnovalidate
	hx-post={ "/packing-lists/" + list.ID + "/preparation/edit" }
	hx-include="closest form"
	hx-vals={ `{"action":"remove"}` }
	hx-confirm="Remove this preparation task?"
	data-confirm-action="Remove task"
	data-confirm-detail="This removes the task from the reusable list."
>Remove task</button>
					</form>
				}
				<form class="task-add" method="post" action={ "/packing-lists/" + list.ID + "/preparation/edit" }>
					<input type="hidden" name="_csrf" value={ csrfToken }/><input type="hidden" name="revision" value={ list.Revision() }/>
					<div class="field"><label for="new-task">New preparation task</label><input id="new-task" name="name" placeholder="Buy fuel" required maxlength="200"/></div>
					@ScopeSelect("scope", "new-task-scope", "", false)
					<button class="btn btn-secondary">Add task</button>
				</form>
				<p class="muted">Preparation and packing are separate: buying fuel does not mark your stove as packed.</p>
				<h3>Improvements from trip reviews</h3>
				<ul class="task-list">
					for _, change := range list.Changes {
						<li>{ change }</li>
					}
				</ul>
			</section>
		</section>
	}
}

templ ListItemForm(form packing.CreateItemForm, csrfToken string) {
	<h2 class="section-title">Add an item</h2>
	<div class="card">
		<form action={ form.Action } method="POST" hx-boost="true">
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			@ItemFields(form, "new")
			if len(form.Error) > 0 {
				@ErrorBanner(form.Error)
			}
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">{ form.SubmitButtonText }</button>
			</div>
		</form>
	</div>
}

// ItemFields is the name and category pair shared by the add and edit forms.
templ ItemFields(form packing.CreateItemForm, suffix string) {
	<input type="hidden" name="revision" value={ form.Revision }/>
	<div class="field-grid">
		<div class={ "field", templ.KV("field-error", form.NameHasError()) }>
			<label for={ "item-name-" + suffix }>Name</label>
			<input type="text" id={ "item-name-" + suffix } name="name" placeholder="Headlamp" value={ form.Name }/>
		</div>
		<div class="field">
			<label for={ "item-category-" + suffix }>Category</label>
			<input type="text" id={ "item-category-" + suffix } name="category" list="list-categories" placeholder="Light" value={ form.Category }/>
		</div>
		<div class="field">
			<label for={ "item-scope-" + suffix }>Who is this for?</label>@ScopeSelect("scope", "item-scope-"+suffix, form.Scope, false)
		</div>
	</div>
}

// ItemRow is one item on the details page. Edit swaps it for ItemEditRow in place.
templ ItemRow(listID string, item packing.PackingItem, csrfToken string) {
	<li class="item-row" id={ "item-" + item.ID }>
		<span class="item-name">{ item.Name }</span>
		if item.Category != "" {
			<span class="tag">{ item.Category }</span>
		}
		<div class="actions">
			<a
				class="btn btn-secondary btn-sm"
				href={ "/packing-lists/" + listID + "/items/" + item.ID + "/edit" }
				hx-get={ "/packing-lists/" + listID + "/items/" + item.ID + "/edit" }
				hx-target="closest li"
				hx-swap="outerHTML"
			>Edit</a>
			<button
				class="btn btn-danger btn-sm"
				hx-delete={ "/packing-lists/" + listID + "/remove-item/" + item.ID }
				hx-headers={ templ.JSONString(map[string]string{"X-CSRF-Token": csrfToken, "X-Camplist-Revision": item.SourceRevision}) }
				hx-confirm="Delete this item?"
				data-confirm-action="Delete item"
			>Delete</button>
		</div>
	</li>
}

// ItemEditRow replaces ItemRow while an item is being edited.
templ ItemEditRow(listID string, itemID string, form packing.CreateItemForm, csrfToken string) {
	<li class="item-row item-row-edit" id={ "item-" + itemID }>
		<form
			class="item-edit-form"
			action={ form.Action }
			method="POST"
			hx-post={ form.Action }
			hx-target="closest li"
			hx-swap="outerHTML"
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			@ItemFields(form, itemID)
			if len(form.Error) > 0 {
				@ErrorBanner(form.Error)
			}
			<div class="form-actions">
				<a
					class="btn btn-secondary btn-sm"
					href={ "/packing-lists/" + listID }
					hx-get={ "/packing-lists/" + listID + "/items/" + itemID }
					hx-target="closest li"
					hx-swap="outerHTML"
				>Cancel</a>
				<button type="submit" class="btn btn-primary btn-sm">{ form.SubmitButtonText }</button>
			</div>
		</form>
	</li>
}

// EditItemPage is the fallback for editing an item without scripts.
templ EditItemPage(list packing.PackingList, form packing.CreateItemForm, csrfToken string) {
	@Layout("Edit item", csrfToken) {
		<datalist id="list-categories">
			for _, category := range categories(list.Items,2000) {
				<option value={ category }></option>
			}
		</datalist>
		<section class="narrow">
			<p class="eyebrow">{ list.Name }</p>
			<h1>Edit item</h1>
			<div class="card">
				<form action={ form.Action } method="POST" hx-boost="true">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					@ItemFields(form, "edit")
					if len(form.Error) > 0 {
						@ErrorBanner(form.Error)
					}
					<div class="form-actions">
						<a class="btn btn-secondary" href={ "/packing-lists/" + list.ID }>Cancel</a>
						<button type="submit" class="btn btn-primary">{ form.SubmitButtonText }</button>
					</div>
				</form>
			</div>
		</section>
	}
}

templ ScopeSelect(name string, id string, scope string, personal bool) {
	<select name={ name } id={ id } aria-label="Who is this for?">
		<option value="shared" selected?={ scope=="" || scope=="shared" }>Shared</option>
		if personal {
			<option value="mine" selected?={ scope=="mine" }>Just for me</option>
		}
		<option value="person" selected?={ scope=="person" }>For each person</option>
	</select>
}
