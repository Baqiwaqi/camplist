package views

import (
	"camplist/internal/auth"
	"camplist/internal/packing"
	"net/url"
)

// SharingPage lists invitations and members. trips are the owner's current trips
// from a shared list; approving names the invitation whose trip prompt is open.
templ SharingPage(view packing.SharingView, link string, token string, trips []packing.PackingSession, approving string) {
	@Layout("Sharing", token) {
		<section class="max-w-[560px]">
			<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700 mb-2">Sharing</p>
			<h1>Pack together.</h1>
			<p class="mb-3"><a class="btn btn-secondary btn-sm" href={ "/" + view.Kind + "/" + view.ID }>Back to your list or trip</a></p>
			if view.Kind=="packing-session" {
				<p class="mb-3">Members can see this trip’s checklist and mark gear packed or unpacked. This does not share the reusable list or other trips.</p>
				<p class="text-muted mb-3">Offline copies may remain on members’ devices after removal. Removal stops future server access.</p>
			} else {
				<p class="mb-3">Editors can update the reusable list and its preparation tasks, and start their own private trips. Existing trips stay unchanged and are shared separately.</p>
			}
			if view.Actor==view.Owner {
				<section class="card">
					<h2>Invite someone</h2>
					<p class="mb-3">Send a separate link to each person. They sign in with Google and request access. Approve only an account you recognize. Links expire after seven days.</p>
					if link!="" {
						<div class="grid gap-1 mb-4" x-data="invitationShare">
							<label for="invitation-link" class="text-sm font-bold">Invitation link</label>
							<input id="invitation-link" type="text" readonly value={ link } class="w-full min-h-11 rounded-sm border border-sand-300 bg-white px-3 py-2 focus-visible:border-pine-700 focus-visible:outline-offset-0" x-ref="invitationLink"/>
							<div class="flex flex-wrap gap-2 justify-self-start">
								<button type="button" class="btn btn-primary" x-show="supported" x-cloak x-on:click="shareInvitation">Share invitation</button>
								<button type="button" class="btn btn-secondary" x-on:click="navigator.clipboard.writeText(document.getElementById('invitation-link').value).then(() => copied = true).catch(() => document.getElementById('invitation-link').select())" x-text="copied ? 'Copied' : 'Copy link'">Copy link</button>
							</div>
							<p class="text-muted text-sm" role="alert" x-show="shareError" x-cloak>Couldn’t open sharing options. Copy the link instead.</p>
						</div>
						<p class="text-muted mb-3">Share or copy this link now. For security, it will not be shown again.</p>
					}
					<form method="post" action={ "/sharing/" + view.Kind + "/" + view.ID + "/invitations" }>
						<input type="hidden" name="_csrf" value={ token }/>
						<button class="btn btn-primary" type="submit">Create invitation link</button>
					</form>
				</section>
				<section class="card mt-8">
					<h2>Invitations and requests</h2>
					for _, invitation:= range view.Sharing.Invitations {
						@InvitationRow(view, invitation, trips, invitation.Hash == approving && invitation.Status == "pending" && len(trips) > 0, token)
					}
				</section>
				<section class="card mt-8">
					<h2>Members</h2>
					for subject,member:=range view.Sharing.Members {
						<div class="item-row">
							<p class="mb-3">{ member.Name } · { member.Email }</p>
							<form method="post" action={ "/sharing/" + view.Kind + "/" + view.ID + "/members/" + subject + "/remove" }>
								<input type="hidden" name="_csrf" value={ token }/><button class="btn btn-danger" type="submit">Remove access</button>
							</form>
						</div>
					}
				</section>
			} else {
				<p class="mb-3">The owner manages invitations and membership.</p>
				<form method="post" action={ "/sharing/" + view.Kind + "/" + view.ID + "/members/" + view.Actor + "/remove" }>
					<input type="hidden" name="_csrf" value={ token }/><button class="btn btn-secondary" type="submit">Leave this shared resource</button>
				</form>
			}
		</section>
	}
}

// InvitationRow is one invitation. For a list with current trips, approving first
// swaps in InvitationRow with the trip prompt open, so the owner can also share
// trips with the same account. Trips stay unshared unless they are ticked.
templ InvitationRow(view packing.SharingView, invitation packing.Invitation, trips []packing.PackingSession, approving bool, token string) {
	<div class="item-row" id={ "invitation-" + invitation.Hash }>
		<div>
			<p class="mb-3">{ invitation.Status } · Expires { invitation.Expires.Format("Jan 2, 2006") }</p>
			if invitation.Applicant!=nil {
				<p class="mb-3">{ invitation.Applicant.Name } · { invitation.Applicant.Email }</p>
				<p class="text-muted mb-3">Google account: { invitation.Applicant.Subject }</p>
			}
		</div>
		if invitation.Status=="pending"||invitation.Status=="open" {
			<form class={ templ.KV("basis-full", approving) } method="post" action={ invitationPath(view, invitation) }>
				<input type="hidden" name="_csrf" value={ token }/>
				if approving {
					<fieldset class="grid gap-2 mb-3">
						<legend class="font-bold mb-2">Also share trips with { applicantName(invitation) }?</legend>
						<p class="text-muted text-sm">Trips started from this list are shared separately. Leave them unticked to share only the list.</p>
						for _, trip := range trips {
							<label class="flex items-center gap-2 min-h-11"><input type="checkbox" name="trip" value={ trip.ID } class="min-h-8 align-middle shrink-0"/><span class="min-w-0 wrap-anywhere">{ trip.DisplayName() }</span></label>
						}
					</fieldset>
					<div class="flex flex-wrap gap-2 max-sm:*:flex-auto">
						<button class="btn btn-primary" name="decision" value="approve">Approve account</button>
						<a
							class="btn btn-secondary"
							href={ templ.SafeURL("/sharing/" + view.Kind + "/" + view.ID) }
							hx-get={ string(invitationPath(view, invitation)) }
							hx-target={ "#invitation-" + invitation.Hash }
							hx-swap="outerHTML"
						>Cancel</a>
					</div>
				} else {
					if invitation.Status=="pending" && view.Kind=="packing-list" && len(trips)>0 {
						<a
							class="btn btn-primary"
							href={ invitationPath(view, invitation) + "/approve" }
							hx-get={ string(invitationPath(view, invitation)) + "/approve" }
							hx-target={ "#invitation-" + invitation.Hash }
							hx-swap="outerHTML"
						>Approve account</a>
					} else if invitation.Status=="pending" {
						<button class="btn btn-primary" name="decision" value="approve">Approve account</button>
					}
					<button class="btn btn-secondary" name="decision" value="revoke">Revoke invitation</button>
				}
			</form>
		}
	</div>
}

func invitationPath(view packing.SharingView, invitation packing.Invitation) templ.SafeURL {
	return templ.SafeURL("/sharing/" + view.Kind + "/" + view.ID + "/invitations/" + invitation.Hash)
}

func applicantName(invitation packing.Invitation) string {
	if invitation.Applicant != nil && invitation.Applicant.Name != "" {
		return invitation.Applicant.Name
	}
	return "this account"
}

// Invitation pages intentionally load no third-party fonts or scripts.
templ JoinPage(link packing.InvitationLink, status string, profile auth.Profile, token string) {
	<!DOCTYPE html>
	<html lang="en">
		<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="referrer" content="no-referrer"/><title>Join · Camplist</title><link rel="stylesheet" href="/static/tailwind.css"/></head>
		<body>
			<main class="max-w-[560px] mx-auto px-4 py-8">
				<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700 mb-2">Invitation</p>
				<h1>Join the packing.</h1>
				<section class="card">
					<p class="mb-3">Signed in as { profile.Name } · { profile.Email }</p>
					<p class="text-muted mb-3">Google account: { profile.Subject }</p>
					<p class="mb-3"><a href={ "/auth/login?switch=1&returnTo=" + url.QueryEscape(link.Path()) }>Use another Google account</a></p>
					if status=="open" {
						<p class="mb-3">Request access with this account. The owner must approve you before you can see or change anything.</p>
						<form method="post" action={ link.Path() }><input type="hidden" name="_csrf" value={ token }/><button class="btn btn-primary">Request access</button></form>
					} else if status=="pending" {
						<p role="status" class="mb-3">Your request is waiting for the owner’s approval.</p>
						<p><a href={ link.Path() }>Check approval</a></p>
					} else {
						<p role="status" class="mb-3">This request was approved. The resource is available while your membership remains active.</p><a class="btn btn-primary" href={ "/" + link.Kind + "/" + link.ID }>Open shared resource</a>
					}
				</section>
			</main>
		</body>
	</html>
}
