package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<script src="/static/htmx.min.js"></script>
			<link rel="stylesheet" href="/static/style.css"/>
			<title>{ title }</title>
		</head>
		<body>
			<header>
				<nav>
					<a href="/">Camplist</a>
					<a href="/sessions">Sessions</a>
				</nav>
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
