package views

import (
	"camplist/internal/auth"
	"camplist/internal/packing"
	"strconv"
	"time"
)

templ PackingSessionsOverviewPage(name string, sessions []packing.PackingSession, archivedCount int, csrfToken string) {
	@Layout(name, csrfToken) {
		<section id="trips-overview">
			@PageHead(PageHeading{
				Title: "Trips",
				Meta:  "Start a trip from one of your packing lists.",
			})
			@TripTabs(false, len(sessions), archivedCount, false)
			@TripsEmptyState(false, len(sessions) == 0, false)
			@PackingSessionCards(sessions, false, csrfToken)
		</section>
	}
}

// TripsEmptyState stands in for the trip cards. It stays in the page, hidden
// while cards exist, so removing the last card can reveal it out of band and
// move focus to it.
templ TripsEmptyState(archive bool, show bool, oob bool) {
	<div
		id="trips-empty"
		class="card"
		tabindex="-1"
		if !show {
			hidden
		}
		if oob {
			hx-swap-oob="true"
		}
	>
		if archive {
			<p class="text-muted">No archived trips yet.</p>
		} else {
			<p class="text-muted">No trips in progress. <a href="/packing-lists">Choose a list</a> to start packing.</p>
		}
	</div>
}

// TripCardRemoved answers an archive, restore or delete whose swap removed
// the trip's card: the page's empty state and the tab counts follow out of
// band. active and archived count the trips left in progress and archived.
templ TripCardRemoved(archive bool, active int, archived int) {
	if archive {
		@TripsEmptyState(archive, archived == 0, true)
	} else {
		@TripsEmptyState(archive, active == 0, true)
	}
	@TripTabs(archive, active, archived, true)
}

// TripTabs switches between the trips in progress and the archive, with a
// count on each. They are separate pages, so the tabs are plain links. A card
// action sends them again out of band so the counts follow the removed card.
templ TripTabs(archive bool, active int, archived int, oob bool) {
	<div id="trip-tabs" class="mb-4" { oobSwap(oob)... }>
		@TabLinks("Trips", []Tab{
			{Label: "In progress", Count: strconv.Itoa(active), Href: "/trips", Current: !archive},
			{Label: "Archive", Count: strconv.Itoa(archived), Href: "/trips/archive", Current: archive},
		})
	</div>
}

templ ArchivedPackingSessionsPage(name string, sessions []packing.PackingSession, activeCount int, csrfToken string) {
	@Layout(name, csrfToken) {
		<section id="trips-archive">
			@PageHead(PageHeading{
				Title: "Trips",
				Meta:  "Fully packed trips move here after 24 hours. Trips you archive yourself can be restored.",
			})
			@TripTabs(true, activeCount, len(sessions), false)
			@TripsEmptyState(true, len(sessions) == 0, false)
			@PackingSessionCards(sessions, true, csrfToken)
		</section>
	}
}

// PackingSessionCards lists trips on the overview or, with archived, on the
// archive page, where the owner's Archive item becomes Restore. The title
// link opens the trip from anywhere on the card; account.mjs adds the
// "Available offline" tag to the card's tag row.
templ PackingSessionCards(sessions []packing.PackingSession, archived bool, csrfToken string) {
	<div id="trip-cards" class="grid gap-3 md:grid-cols-2">
		for _, s := range sessions {
			<article class="card" data-saved-trip={ s.ID }>
				<div class="flex items-start gap-3">
					<div class="min-w-0 flex-auto">
						<h2 class="t-object mb-0"><a class="card-link" href={ "/trips/" + s.ID }>{ tripCardTitle(s) }</a></h2>
						<p class="text-meta text-muted mt-1">Started <time datetime={ s.CreatedAt.Format(time.RFC3339) }>{ s.CreatedAt.Format(startDateLayout) }</time></p>
					</div>
					@Menu("More") {
						@MenuLink("/sharing/packing-session/"+s.ID, "Sharing")
						if s.UserID == auth.Subject(ctx) {
							@MenuLink("/trips/"+s.ID+"/review", "Review this trip")
							if !archived {
								@MenuButton("Archive trip", false, tripCardAction("/trips/"+s.ID+"/archive"))
							} else if s.CanRestore(time.Now().UTC()) {
								@MenuButton("Restore trip", false, tripCardAction("/trips/"+s.ID+"/restore"))
							}
							@MenuSeparator()
							@MenuButton("Delete trip", true, deleteTripAttrs(s.ID, archived))
						}
					}
				</div>
				<div class="mt-auto grid gap-3 pt-3">
					<div class="flex flex-wrap gap-1.5 empty:hidden" data-card-tags>
						if s.IsShared() {
							<span class="tag">Shared</span>
						}
					</div>
					@ProgressBar(s.List.CountChecked(), len(s.List.Items), tripStatus(s))
				</div>
			</article>
		}
	</div>
}
