package views

import (
	"camplist/internal/auth"
	"camplist/internal/packing"
	"fmt"
	"strings"
	"time"
)

templ PackingSessionsOverviewPage(name string, sessions []packing.PackingSession, archivedCount int, csrfToken string) {
	@Layout(name, csrfToken) {
		<section id="trips-overview">
			<div class="flex flex-wrap justify-between items-start gap-4 mb-6 max-sm:flex-col max-sm:items-stretch">
				<div class="min-w-0 max-sm:flex-none sm:flex-[1_1_320px]">
					<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700 mb-2">Trips</p>
					<h1>Trips in progress</h1>
					<p class="text-muted max-w-[60ch]">Prepare and pack together. Your reusable packing lists stay separate.</p>
				</div>
				<div class="flex flex-wrap items-center gap-2 sm:pt-6">
					@TripArchiveLink(archivedCount, false)
				</div>
			</div>
			@TripsEmptyState(false, len(sessions) == 0, false)
			@PackingSessionCards(sessions, false, csrfToken)
		</section>
	}
}

// TripsEmptyState stands in for the trip cards. It stays in the page, hidden
// while cards exist, so removing the last card can reveal it out of band and
// move focus to it.
templ TripsEmptyState(archive bool, show bool, oob bool) {
	<div
		id="trips-empty"
		class="card"
		tabindex="-1"
		if !show {
			hidden
		}
		if oob {
			hx-swap-oob="true"
		}
	>
		if archive {
			<p class="text-muted">No archived trips yet.</p>
		} else {
			<p class="text-muted">No trips in progress. <a href="/packing-lists">Choose a list</a> to start packing.</p>
		}
	</div>
}

// TripCardRemoved answers an archive, restore or delete whose swap removed
// the trip's card: the page's empty state and, on the overview, the archive
// count follow out of band. remaining counts the cards left on that page.
templ TripCardRemoved(archive bool, remaining int, archivedCount int) {
	@TripsEmptyState(archive, remaining == 0, true)
	if !archive {
		@TripArchiveLink(archivedCount, true)
	}
}

// TripArchiveLink leads from the trips overview to the archive. Archiving a
// trip sends it again out of band so the count follows the removed card.
templ TripArchiveLink(count int, oob bool) {
	<a
		id="trip-archive-link"
		class="btn btn-secondary max-sm:flex-auto"
		href="/trips/archive"
		if oob {
			hx-swap-oob="true"
		}
	>Archive ({ fmt.Sprint(count) })</a>
}

templ ArchivedPackingSessionsPage(name string, sessions []packing.PackingSession, csrfToken string) {
	@Layout(name, csrfToken) {
		<section id="trips-archive">
			<div class="flex flex-wrap justify-between items-start gap-4 mb-6 max-sm:flex-col max-sm:items-stretch">
				<div class="min-w-0 max-sm:flex-none sm:flex-[1_1_320px]">
					<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700 mb-2">Trips</p>
					<h1>Trip archive</h1>
					<p class="text-muted max-w-[60ch]">Fully packed trips move here automatically after 24 hours. Trips you archive yourself can be restored.</p>
				</div>
				<div class="flex flex-wrap items-center gap-2 sm:pt-6">
					<a class="btn btn-secondary max-sm:flex-auto" href="/trips">Current trips</a>
				</div>
			</div>
			@TripsEmptyState(true, len(sessions) == 0, false)
			@PackingSessionCards(sessions, true, csrfToken)
		</section>
	}
}

// startDateLayout matches the date the store appends to a new trip's name.
const startDateLayout = "Jan 2, 2006"

// nameEndsWithStartDate reports whether the trip name already shows its start
// date, as default names do, so the card need not repeat it.
func nameEndsWithStartDate(s packing.PackingSession) bool {
	return strings.HasSuffix(s.DisplayName(), s.CreatedAt.Format(startDateLayout))
}

// PackingSessionCards lists trips on the overview or, with archived, on the
// archive page, where the owner's Archive item becomes Restore.
templ PackingSessionCards(sessions []packing.PackingSession, archived bool, csrfToken string) {
	for _, s := range sessions {
		<article class="card" data-saved-trip={ s.ID }>
			if s.IsShared() {
				<p class="inline-block whitespace-nowrap text-xs font-bold tracking-tag uppercase text-pine-700 bg-pine-100 px-2 py-0.5 rounded-full mb-2">Shared</p>
			}
			<div class="flex flex-wrap justify-between items-start gap-4 mb-4 max-sm:flex-col">
				<div class="min-w-0 max-sm:flex-none sm:flex-[1_1_240px]">
					<h2><a class="no-underline" href={ "/trips/" + s.ID }>{ s.DisplayName() }</a></h2>
					if !nameEndsWithStartDate(s) {
						<p class="text-muted mb-3">Started <time datetime={ s.CreatedAt.Format(time.RFC3339) }>{ s.CreatedAt.Format(startDateLayout) }</time></p>
					}
				</div>
				<div class="flex flex-wrap items-center gap-2 max-sm:w-full">
					if allPacked(s.List.CountChecked(), len(s.List.Items)) {
						<a class="btn btn-secondary btn-sm" href={ "/trips/" + s.ID }>Open</a>
					} else {
						<a class="btn btn-primary btn-sm max-sm:flex-auto" href={ "/trips/" + s.ID }>Keep packing</a>
					}
					@Menu("More") {
						@MenuLink("/sharing/packing-session/"+s.ID, "Sharing")
						if s.UserID == auth.Subject(ctx) {
							@MenuLink("/trips/"+s.ID+"/review", "Review this trip")
							if !archived {
								@MenuButton("Archive trip", false, tripCardAction("/trips/"+s.ID+"/archive"))
							} else if s.CanRestore(time.Now().UTC()) {
								@MenuButton("Restore trip", false, tripCardAction("/trips/"+s.ID+"/restore"))
							}
							@MenuSeparator()
							@MenuButton("Delete trip", true, deleteTripAttrs(s.ID, archived))
						}
					}
				</div>
			</div>
			@ProgressBar(s.List.CountChecked(), len(s.List.Items), "")
		</article>
	}
}
