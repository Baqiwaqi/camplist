package views

import (
	"camplist/internal/auth"
	"camplist/internal/packing"
	"strconv"
	"time"
)

templ PackingSessionPage(name string, session packing.PackingSession, canReview bool, csrfToken string) {
	@Layout(name, csrfToken) {
		<section>
			<div class="page-head">
				<div>
					<p class="eyebrow">Packing session</p>
					<h1>{ session.List.Name }</h1>
					<p class="muted lede">
						Started <time datetime={ session.CreatedAt.Format(time.RFC3339) }>{ session.CreatedAt.Format("Jan 2, 2006") }</time>.
						Your reusable list stays unchanged.
					</p>
				</div>
				<div class="actions">
					if canReview {
						<a class="btn btn-secondary" href={ "/packing-session/" + session.ID + "/review" }>Review this trip</a>
					}
					<a class="btn btn-secondary" href={ "/sharing/packing-session/" + session.ID }>Sharing</a>
					<a class="btn btn-secondary" href="/sessions">All sessions</a>
				</div>
			</div>
			if session.IsShared() {
				<p class="muted">Shared trip. Changes saved on this device are visible to others only after syncing. Offline views may miss other people’s changes.</p>
			}
			@templ.JSONScript("packing-snapshot", session.Snapshot(auth.Subject(ctx)))
			<p class="muted" id="packing-save-status" role="status">Packing saves as you go. Preparing offline access…</p>
			<noscript><p>Packing requires a connection when JavaScript is disabled.</p></noscript>
			if session.UserID==auth.Subject(ctx) {
				<section class="card">
					<h2>Before this trip</h2>
					<p class="muted">Preparation recorded when this session started. <a href={ "/packing-list/" + session.TemplateID() }>Manage current preparation tasks</a>.</p>
					<ul class="task-list">
						for _, task := range session.List.Tasks {
							if !task.Done {
								<li>{ task.Name }</li>
							}
						}
					</ul>
					if len(session.Improvements) > 0 {
						<h3>Changes since your previous outing</h3>
						<ul class="task-list">
							for _, change := range session.Improvements {
								<li>{ change }</li>
							}
						</ul>
					}
				</section>
			}
			@PackingChecklist(session, csrfToken)
		</section>
	}
}

templ PackingChecklist(session packing.PackingSession, csrfToken string) {
	<section id="packing-checklist" aria-label="Packing checklist">
		if allPacked(session.List.CountChecked(), len(session.List.Items)) {
			<div class="card card-brand progress-card">
				<p class="display">All packed. Go!</p>
				@ProgressBar(session.List.CountChecked(), len(session.List.Items), "")
			</div>
		} else {
			<div class="card progress-card">
				@ProgressBar(session.List.CountChecked(), len(session.List.Items), "Keep packing")
			</div>
		}
		<div class="card">
			if len(session.List.Items) == 0 {
				<p class="muted">This session has no items. Add gear to your reusable list and start a new session.</p>
			} else {
				<div class="columns pack-columns">
					for _, group := range groupByCategory(session.List.Items) {
						<div class="pack-group">
							if group.Name != "" {
								<p class="group-label">{ group.Name }</p>
							}
							<ul class="item-list pack-list">
								for _, item := range group.Items {
									@PackingSessionItem(session.ID, item, csrfToken)
								}
							</ul>
						</div>
					}
				</div>
			}
		</div>
	</section>
}

templ PackingSessionItem(sessionID string, item packing.PackingItem, csrfToken string) {
	<li class="item-row">
		<form
			method="post"
			action="/packing-session/set-item"
			class="pack-form"
			hx-post="/packing-session/set-item"
			hx-target="#packing-checklist"
			hx-swap="outerHTML"
			hx-disabled-elt="#packing-checklist button"
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			<input type="hidden" name="sessionId" value={ sessionID }/>
			<input type="hidden" name="itemId" value={ item.ID }/>
			<input type="hidden" name="expectedRevision" value={ strconv.FormatInt(item.Revision, 10) }/>
			<input type="hidden" name="checked" value={ strconv.FormatBool(!item.Checked) }/>
			<button
				id={ "pack-" + item.ID }
				type="submit"
				class={ "pack-row", templ.KV("packed", item.Checked) }
				aria-pressed={ strconv.FormatBool(item.Checked) }
				aria-label={ "Toggle packed status for " + item.Name }
			>
				<span class="tick" aria-hidden="true"></span>
				<span class="pack-name">{ item.Name }</span>
				<span class="pack-action">
					if item.Checked {
						Unpack
					} else {
						Pack
					}
				</span>
			</button>
		</form>
	</li>
}
