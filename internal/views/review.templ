package views

import "camplist/internal/packing"
import "slices"
import "strconv"
import "camplist/internal/auth"

// ReviewPage stacks its sections 2rem apart on phones and 3rem from 721px:
// every section after the first carries reviewSectionGap, and which section
// is first depends on who is looking and whether the reusable list is still
// available.
templ ReviewPage(session packing.PackingSession, list packing.PackingList, available bool, recoverable bool, entry packing.ReviewEntry, categories []packing.CategoryOption, message string, csrfToken string) {
	@Layout("Review your trip", csrfToken) {
		@PageHead(PageHeading{
			Title:     "Make the next trip easier",
			Meta:      "Review " + session.List.Name + ". Observations stay with this trip; only selected changes affect your next one.",
			BackHref:  "/trips/" + session.ID,
			BackLabel: session.List.Name,
		})
		if message != "" {
			<p class="error" role="alert">{ message }</p>
		}
		if session.UserID==auth.Subject(ctx) {
			<section>
				@SectionHead("What did you notice?", "")
				<div class="card mb-0 md:p-6">
					@ReviewForm(session, list.Revision(), available, entry, categories, "", false, csrfToken)
				</div>
				@reviewSaveStatus("")
			</section>
		}
		if !available {
			<section class={ templ.KV(reviewSectionGap, session.UserID == auth.Subject(ctx)) }>
				@SectionHead("The reusable list is unavailable", "")
				<div class="card mb-0">
					<p>Your trip and observations are still here.</p>
					if recoverable {
						<form method="post" action={ "/trips/" + session.ID + "/review/recover" }>
							<input type="hidden" name="_csrf" value={ csrfToken }/>
							<button class="btn btn-primary mt-3" type="submit">Create a new list from this trip</button>
						</form>
					} else {
						<p class="text-muted mt-1">Your access to the template was removed. Your own trip observations remain available here.</p>
					}
				</div>
			</section>
		}
		@TripObservations(session, list, available, session.UserID == auth.Subject(ctx) || !available, csrfToken, nil)
		if available {
			@CurrentReviewList(list, nil)
		}
	}
}

// reviewSectionGap is the space above every review section after the first.
const reviewSectionGap = "mt-8 md:mt-12"

// ReviewForm records one observation. htmx swaps the form in place, so a save
// comes back as a fresh form (new entry ID) or the submitted values with an
// error; without JavaScript it posts normally and the handler redirects.
// "Save and apply now" also applies the proposed change, so it is offered only
// while the reusable list is available and a change is proposed. focusSave
// moves focus to Save observation after that button disappears in a swap.
// From 721px the gear fields share one row, what was noticed spans the form,
// and the proposed change sits beside its task.
templ ReviewForm(session packing.PackingSession, revision string, available bool, entry packing.ReviewEntry, categories []packing.CategoryOption, message string, focusSave bool, csrfToken string) {
	<form
		id="review-form"
		class="grid gap-4 md:grid-cols-6 md:gap-x-6"
		method="post"
		action={ "/trips/" + session.ID + "/review" }
		hx-post={ "/trips/" + session.ID + "/review" }
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="this:drop"
		x-data="{ action: '' }"
		x-init="action = $el.elements.action.value"
		x-on:change="if ($event.target.name === 'action') action = $event.target.value"
	>
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<input type="hidden" name="entryId" value={ entry.ID }/>
		if available {
			<input type="hidden" name="revision" value={ revision }/>
		}
		<div class="min-w-0 md:col-span-2">
			@SelectField("review-item", "itemId", "Existing gear (optional)", false, reviewItemOptions(session), entry.ItemID)
		</div>
		<div class="min-w-0 md:col-span-2">
			@Field(TextField{
				ID:    "review-name",
				Name:  "name",
				Label: "Name of new or missing gear",
				Value: entry.Name,
				Attrs: templ.Attributes{"maxlength": "200"},
			})
		</div>
		<div class="min-w-0 md:col-span-2">
			<label for="review-category" class="label">Category</label>
			@CategoryPicker("review-category", "review-category-options", entry.Category, "Pick or type one", categories)
		</div>
		<fieldset class="min-w-0 md:col-span-6">
			<legend class="label">Observations (choose at least one)</legend>
			<div class="flex flex-wrap gap-2">
				@Chip("forgotten", "true", "Forgotten", entry.Forgotten)
				@Chip("unused", "true", "Unused", entry.Unused)
				@Chip("needsAttention", "true", "Needs repair or replacement", entry.NeedsAttention)
			</div>
		</fieldset>
		<div class="md:col-span-6">
			@Field(TextField{
				ID:        "review-note",
				Name:      "note",
				Label:     "Notes",
				Value:     entry.Note,
				Multiline: true,
				Attrs:     templ.Attributes{"maxlength": "2000"},
			})
		</div>
		<div class="min-w-0 md:col-span-3">
			@SelectField("review-action", "action", "Proposed change", false, reviewActionOptions, string(entry.Action))
		</div>
		<div class="min-w-0 md:col-span-3">
			@Field(TextField{
				ID:          "review-task",
				Name:        "task",
				Label:       "Preparation task (when selected)",
				Value:       entry.Task,
				Placeholder: "Replace gas canister",
				Attrs:       templ.Attributes{"maxlength": "200"},
			})
		</div>
		<div class="md:col-span-6 grid gap-3">
			<p class="text-meta text-muted max-w-[70ch]">Saving keeps the observation with this trip. A proposed change reaches your reusable list only when you apply it. Unused safety equipment may still be essential; nothing is removed automatically.</p>
			// The error sits by the buttons, where a phone user who just tapped one is looking.
			if message != "" {
				<p class="error" role="alert">{ message }</p>
			}
			<div class="flex flex-wrap items-center gap-2">
				<button id="review-submit" class="btn btn-primary in-[.htmx-request]:opacity-60 in-[.htmx-request]:cursor-progress" type="submit" autofocus?={ focusSave }>Save observation</button>
				if available {
					<button
						id="review-save-apply"
						class="btn btn-secondary in-[.htmx-request]:opacity-60 in-[.htmx-request]:cursor-progress"
						type="submit"
						name="apply"
						value="true"
						hidden?={ entry.Action == "" || entry.Action == packing.ReviewObserve }
						x-bind:hidden="action === 'none'"
					>Save and apply now</button>
				}
			</div>
		</div>
	</form>
}

var reviewActionOptions = []SelectOption{
	{Value: string(packing.ReviewObserve), Label: "Keep observation only"},
	{Value: string(packing.ReviewAdd), Label: "Add gear to future lists"},
	{Value: string(packing.ReviewRemove), Label: "Remove selected existing gear"},
	{Value: string(packing.ReviewTask), Label: "Create a preparation task"},
}

func reviewItemOptions(session packing.PackingSession) []SelectOption {
	options := []SelectOption{{Value: "", Label: "New or missing gear"}}
	for _, item := range session.List.Items {
		options = append(options, SelectOption{Value: item.ID, Label: item.Name})
	}
	return options
}

// reviewSaveStatus stays in the page so screen readers announce the text an
// out-of-band swap puts inside it.
templ reviewSaveStatus(text string) {
	<p id="review-save-status" role="status" class="text-meta text-muted mt-3 empty:mt-0">{ text }</p>
}

// reviewChange describes a proposed change as a sentence, for the apply
// checkbox and the applied confirmation.
func reviewChange(observation packing.ReviewEntry) string {
	switch observation.Action {
	case packing.ReviewAdd:
		return "Add " + observation.Name + " to the list"
	case packing.ReviewRemove:
		return "Remove " + observation.Name + " from the list"
	case packing.ReviewTask:
		return "Add the preparation task " + observation.Task
	}
	return "Keep " + observation.Name + " as an observation"
}

// TripObservations lists this trip's observations with the apply form, one
// hairline row each. spaced adds the gap it needs when another section sits
// above it. Each proposed change is labelled applied or waiting, from the
// list's applied reviews, while the list is available.
templ TripObservations(session packing.PackingSession, list packing.PackingList, available bool, spaced bool, csrfToken string, attrs templ.Attributes) {
	<section id="trip-observations" class={ templ.KV(reviewSectionGap, spaced) } { attrs... }>
		@SectionHead("Trip observations", strconv.Itoa(len(session.Review)))
		<div class="card mb-0">
			if len(session.Review) == 0 {
				<p class="text-muted">No observations yet.</p>
			}
			<form method="post" action={ "/trips/" + session.ID + "/review/apply" }>
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				<input type="hidden" name="revision" value={ list.Revision() }/>
				for _, observation := range session.Review {
					<article class="py-3 first-of-type:pt-0 border-b border-sand-100 last-of-type:border-b-0 last-of-type:pb-0">
						<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
							<h3 class="my-0 mr-auto font-sans text-body font-semibold tracking-normal">{ observation.Name }</h3>
							if available && observation.Action != packing.ReviewObserve {
								if slices.Contains(list.AppliedReviews, session.ID + ":" + observation.ID) {
									<span class="tag">Applied</span>
								} else {
									<span class="tag tag-quiet">Waiting to be applied</span>
								}
							}
						</div>
						<p class="text-muted mt-1 empty:hidden">{ reviewNoticed(observation) }</p>
						if observation.Action != packing.ReviewObserve {
							if slices.Contains(list.AppliedReviews, session.ID + ":" + observation.ID) {
								<p class="mt-2">{ reviewChange(observation) }. Applied to future trips.</p>
							} else if available {
								<label class="flex items-center gap-2 min-h-11 mt-1 cursor-pointer">
									<input type="checkbox" name="selected" value={ observation.ID } class="shrink-0"/>
									<span class="min-w-0 wrap-anywhere">{ reviewChange(observation) }</span>
								</label>
							}
						}
					</article>
				}
				if available && len(session.Review) > 0 {
					<button class="btn btn-primary mt-4" type="submit">Apply selected changes</button>
				}
			</form>
		</div>
	</section>
}

// reviewNoticed is what was noticed about the gear, followed by the note, as
// one line: "Forgotten. Fingers froze packing up."
func reviewNoticed(observation packing.ReviewEntry) string {
	text := ""
	if observation.Forgotten {
		text += "Forgotten. "
	}
	if observation.Unused {
		text += "Unused. "
	}
	if observation.NeedsAttention {
		text += "Needs attention. "
	}
	return text + observation.Note
}

// CurrentReviewList shows the reusable list the proposals compare against:
// its gear and preparation tasks as one compact sheet of hairline rows.
templ CurrentReviewList(list packing.PackingList, attrs templ.Attributes) {
	<section id="current-review-list" class={ reviewSectionGap } { attrs... }>
		@SectionHead("Current list", itemCount(len(list.Items)))
		<p class="text-meta text-muted -mt-1 mb-3">{ list.Name } as it is now. Compare your proposals before applying.</p>
		<div class="card mb-0 py-1">
			if len(list.Items) == 0 && len(list.Tasks) == 0 {
				<p class="py-2 text-muted">This list is empty.</p>
			}
			if len(list.Items) > 0 {
				<ul aria-label="Gear">
					for _, item := range list.Items {
						<li class="flex flex-wrap items-baseline justify-between gap-x-3 py-2 border-b border-sand-100 last:border-b-0">
							<span class="min-w-0 font-semibold wrap-anywhere">{ item.Name }</span>
							if item.Category != "" {
								<span class="text-meta text-muted">{ item.Category }</span>
							}
						</li>
					}
				</ul>
			}
			if len(list.Tasks) > 0 {
				<h3 class={ "my-0 pt-3 pb-1 font-sans text-meta font-semibold tracking-normal text-muted", templ.KV("border-t border-sand-100", len(list.Items) > 0) }>Preparation tasks</h3>
				<ul aria-label="Preparation tasks">
					for _, task := range list.Tasks {
						<li class="py-2 border-b border-sand-100 last:border-b-0 font-semibold wrap-anywhere">{ task.Name }</li>
					}
				</ul>
			}
		</div>
	</section>
}

// ReviewSaved answers an htmx save: a fresh form, the confirmation, and the
// observations section with the new entry. message reports a change that was
// saved but could not be applied; listChanged moves focus to Save observation
// after an apply attempt. The list section is refreshed too, so it shows the
// revision the new forms carry.
templ ReviewSaved(session packing.PackingSession, list packing.PackingList, available bool, entry packing.ReviewEntry, categories []packing.CategoryOption, saved string, message string, listChanged bool, csrfToken string) {
	@ReviewForm(session, list.Revision(), available, entry, categories, message, listChanged, csrfToken)
	<div id="review-save-status" hx-swap-oob="innerHTML">{ saved }</div>
	@TripObservations(session, list, available, true, csrfToken, templ.Attributes{"hx-swap-oob": "outerHTML"})
	if available {
		@CurrentReviewList(list, templ.Attributes{"hx-swap-oob": "outerHTML"})
	}
}

// ReviewFormError answers a failed htmx save with the form, the submitted
// values and revision, and the message, and clears an earlier confirmation.
templ ReviewFormError(session packing.PackingSession, revision string, available bool, entry packing.ReviewEntry, categories []packing.CategoryOption, message string, csrfToken string) {
	@ReviewForm(session, revision, available, entry, categories, message, false, csrfToken)
	<div id="review-save-status" hx-swap-oob="innerHTML"></div>
}
