package views

import (
	"camplist/internal/auth"
	"camplist/internal/packing"
	"strconv"
	"time"
)

templ PackingSessionPage(name string, session packing.PackingSession, canReview bool, csrfToken string) {
	@Layout(name, csrfToken) {
		<section>
			<div class="flex flex-wrap justify-between items-start gap-4 mb-6 max-sm:flex-col max-sm:items-stretch">
				<div class="min-w-0 max-sm:flex-none sm:flex-[1_1_320px]">
					<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700 mb-2">Packing session</p>
					<h1>{ session.List.Name }</h1>
					<p class="text-muted max-w-[60ch]">
						Started <time datetime={ session.CreatedAt.Format(time.RFC3339) }>{ session.CreatedAt.Format("Jan 2, 2006") }</time>.
						Your reusable list stays unchanged.
					</p>
				</div>
				<div class="flex flex-wrap items-center gap-2 sm:pt-6">
					if canReview {
						<a class="btn btn-secondary" href={ "/packing-session/" + session.ID + "/review" }>Review this trip</a>
					}
					@PageMenu("More") {
						@MenuLink("/sharing/packing-session/"+session.ID, "Sharing")
						@MenuLink("/sessions", "All sessions")
					}
				</div>
			</div>
			if session.IsShared() {
				<p class="text-muted mb-3">Shared trip. Changes saved on this device are visible to others only after syncing. Offline views may miss other people’s changes.</p>
			}
			@templ.JSONScript("packing-snapshot", session.Snapshot(auth.Subject(ctx)))
			<p class="sync-status text-sm" id="packing-save-status" role="status">Packing saves as you go. Preparing offline access…</p>
			<noscript><p class="mb-3">Packing requires a connection when JavaScript is disabled.</p></noscript>
			if session.UserID==auth.Subject(ctx) {
				@SessionPreparation(session, csrfToken)
			}
			@PackingChecklist(session, csrfToken)
		</section>
	}
}

templ PackingChecklist(session packing.PackingSession, csrfToken string) {
	<section id="packing-checklist" aria-label="Packing checklist">
		if allPacked(session.List.CountChecked(), len(session.List.Items)) {
			<div class="card card-brand progress-card">
				<p class="display mb-3">All packed. Go!</p>
				@ProgressBar(session.List.CountChecked(), len(session.List.Items), "")
			</div>
		} else {
			<div class="card progress-card">
				@ProgressBar(session.List.CountChecked(), len(session.List.Items), "Keep packing")
			</div>
		}
		<div class="card">
			if len(session.List.Items) == 0 {
				<p class="text-muted">This session has no items. Add gear to your reusable list and start a new session.</p>
			} else {
				<div class="columns-[14rem] gap-x-8">
					for _, group := range groupByCategory(session.List.Items) {
						<div class="break-inside-avoid pb-3 last:pb-0">
							if group.Name != "" {
								<p class="text-xs font-bold tracking-eyebrow uppercase text-muted pb-1">{ group.Name }</p>
							}
							<ul>
								for _, item := range group.Items {
									@PackingSessionItem(session.ID, item, csrfToken)
								}
							</ul>
						</div>
					}
				</div>
			}
		</div>
	</section>
}

templ PackingSessionItem(sessionID string, item packing.PackingItem, csrfToken string) {
	<li class="item-row py-0">
		<form
			method="post"
			action="/packing-session/set-item"
			class="pack-form w-full"
			hx-post="/packing-session/set-item"
			hx-target="#packing-checklist"
			hx-swap="outerHTML"
			hx-disabled-elt="#packing-checklist button"
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			<input type="hidden" name="sessionId" value={ sessionID }/>
			<input type="hidden" name="itemId" value={ item.ID }/>
			<input type="hidden" name="expectedRevision" value={ strconv.FormatInt(item.Revision, 10) }/>
			<input type="hidden" name="checked" value={ strconv.FormatBool(!item.Checked) }/>
			<button
				id={ "pack-" + item.ID }
				type="submit"
				class={ "pack-row", templ.KV("packed", item.Checked) }
				aria-pressed={ strconv.FormatBool(item.Checked) }
				aria-label={ "Toggle packed status for " + item.Name }
			>
				<span class="tick" aria-hidden="true"></span>
				<span class="pack-name">{ item.Name }</span>
				<span class="pack-action">
					if item.Checked {
						Unpack
					} else {
						Pack
					}
				</span>
			</button>
		</form>
	</li>
}

// SessionPreparation sits above the checklist; the extra bottom margin keeps
// the two sections the usual 2rem apart.
templ SessionPreparation(session packing.PackingSession, csrfToken string) {
	<section class="card mb-8" id="session-preparation">
		<h2>Before this trip</h2>
		<p class="text-muted mb-3">Mark preparation done for this trip. These tasks need a connection to save. <a href={ "/packing-list/" + session.TemplateID() }>Manage reusable preparation tasks</a>.</p>
		<ul>
			for _, task := range session.List.Tasks {
				<li class="item-row">
					<form
						method="post"
						action={ "/packing-session/" + session.ID + "/preparation" }
						hx-post={ "/packing-session/" + session.ID + "/preparation" }
						hx-target="#session-preparation"
						hx-swap="outerHTML"
						hx-disabled-elt="#session-preparation button"
						class="pack-form w-full"
					>
						<input type="hidden" name="_csrf" value={ csrfToken }/>
						<input type="hidden" name="taskId" value={ task.ID }/>
						<input type="hidden" name="done" value={ strconv.FormatBool(!task.Done) }/>
						<input type="hidden" name="expectedRevision" value={ strconv.FormatInt(task.Revision, 10) }/>
						<button type="submit" class={ "pack-row", templ.KV("packed",task.Done) } aria-pressed={ strconv.FormatBool(task.Done) } aria-label={ "Toggle completion for " + task.Name }>
							<span class="tick" aria-hidden="true"></span><span class="pack-name">{ task.Name }</span>
							<span class="pack-action">
								if task.Done {
									Undo
								} else {
									Mark done
								}
							</span>
						</button>
					</form>
				</li>
			}
		</ul>
		if len(session.Improvements)>0 {
			<h3>Changes since your previous outing</h3>
			<ul>
				for _, change := range session.Improvements {
					<li class="py-2 border-b border-sand-100 font-bold last:border-b-0">{ change }</li>
				}
			</ul>
		}
	</section>
}
