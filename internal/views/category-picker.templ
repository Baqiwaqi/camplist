package views

import "camplist/internal/packing"

// CategoryPicker is the category field on item forms: a combobox shaped like
// the Pines UI one that offers options (the default categories, the ones on
// this list and the camper's remembered ones), filters them while typing and
// keeps a new name as typed. A new name close to an existing category (a
// likely typo) first offers the existing one. Each remembered custom category
// carries an Edit button that opens CategoryDialog in the layout, where it can
// be renamed or removed.
//
// The popup is a grid rather than a listbox, because a row holds two things:
// the category to choose and, for a remembered one, that Edit button. ARIA
// forbids interactive descendants inside an option, so the button would never
// reach a screen reader there; as its own grid cell it does. Left and right
// arrows move between the two cells of a row.
//
// The text input is the real form field and the options are a server-rendered
// datalist, so without JavaScript it is a plain field with the browser's
// suggestions and a link to the categories page. Behaviour lives in
// static/category-picker.js (Alpine.data("categoryPicker")). optionsID names
// the datalist, which the offline scripts look up to add trip categories.
// The popup's ids are bound rather than rendered, like views.Menu's: htmx
// restores rendered attributes of elements with an id after a boosted swap,
// which would undo Alpine's x-show.
templ CategoryPicker(id string, optionsID string, value string, placeholder string, options []packing.CategoryOption) {
	<div
		class="relative"
		x-data="categoryPicker"
		x-on:focusout="leave($event)"
		x-on:click.outside="close()"
	>
		<input
			type="text"
			id={ id }
			name="category"
			value={ value }
			maxlength="100"
			list={ optionsID }
			placeholder={ placeholder }
			autocomplete="off"
			role="combobox"
			aria-autocomplete="list"
			aria-expanded="false"
			aria-haspopup="grid"
			x-ref="input"
			x-bind:aria-controls="listboxID()"
			x-bind:aria-expanded="matches().length > 0"
			x-bind:aria-activedescendant="activeID()"
			x-on:focus="detach()"
			x-on:click="show()"
			x-on:input="filter()"
			x-on:keydown.arrow-down.prevent="move(1)"
			x-on:keydown.arrow-up.prevent="move(-1)"
			x-on:keydown.arrow-right="across($event, 1)"
			x-on:keydown.arrow-left="across($event, -1)"
			x-on:keydown.enter="enter($event)"
			x-on:keydown.escape="escape($event)"
			class="field"
		/>
		<datalist id={ optionsID }>
			@categoryOptions(options)
		</datalist>
		<noscript>
			<a href="/categories" class="block w-fit py-1 text-sm">Fix a category name</a>
		</noscript>
		<div
			x-bind:id="listboxID()"
			role="grid"
			aria-label="Categories"
			x-show="matches().length > 0"
			x-cloak
			x-transition:enter="drop-enter"
			x-transition:enter-start="drop-start"
			x-transition:enter-end="drop-end"
			class="popup picker-popup"
		>
			<template x-for="(item, index) in matches()" x-bind:key="item.label">
				<div role="row" class="option-row" x-on:mousedown.prevent>
					<span
						role="gridcell"
						class="option"
						x-bind:class="item.kind === 'option' ? '' : 'option-new'"
						x-bind:id="optionID(index)"
						x-bind:aria-selected="index === active && column === 0"
						x-bind:data-active="index === active && column === 0"
						x-text="item.label"
						x-on:mousemove="point(index)"
						x-on:click="pick(item)"
					></span>
					<template x-if="item.custom">
						<span role="gridcell" class="flex-none">
							<button
								type="button"
								class="option-action"
								tabindex="-1"
								x-bind:id="actionID(index)"
								x-bind:aria-label="`Rename or remove ${item.value}`"
								x-bind:data-active="index === active && column === 1"
								x-on:mousemove="point(index)"
								x-on:click.stop="manage(item.value)"
							>Edit</button>
						</span>
					</template>
				</div>
			</template>
		</div>
	</div>
}

// categoryOptions renders a picker's datalist options. data-default marks the
// defaults, whose spelling a typed name adopts; data-custom marks the
// remembered categories the picker can rename or remove; data-used marks the
// categories on the items in view.
templ categoryOptions(options []packing.CategoryOption) {
	for _, option := range options {
		<option value={ option.Name } data-default?={ packing.IsDefaultCategory(option.Name) } data-custom?={ option.Custom } data-used?={ option.Used }></option>
	}
}
