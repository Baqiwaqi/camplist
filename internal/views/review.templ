package views

import "camplist/internal/packing"
import "slices"
import "camplist/internal/auth"

// ReviewPage stacks its cards 2rem apart: every card after the first carries
// mt-8, and which card is first depends on who is looking and whether the
// reusable list is still available.
templ ReviewPage(session packing.PackingSession, list packing.PackingList, available bool, recoverable bool, entry packing.ReviewEntry, categories []string, message string, csrfToken string) {
	@Layout("Review your trip", csrfToken) {
		<div class="flex flex-wrap justify-between items-start gap-4 mb-6 max-sm:flex-col max-sm:items-stretch">
			<div class="min-w-0 max-sm:flex-none sm:flex-[1_1_320px]">
				<h1>Make the next trip easier</h1>
				<p class="text-muted max-w-[60ch]">Review { session.List.Name }. Observations stay with this trip; only selected changes affect your next one.</p>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<a class="btn btn-secondary" href={ "/trips/" + session.ID }>Back to packing</a>
			</div>
		</div>
		if message != "" {
			<p class="error" role="alert">{ message }</p>
		}
		if session.UserID==auth.Subject(ctx) {
			<section class="card">
				<h2>What did you notice?</h2>
				@ReviewForm(session, list.Revision(), available, entry, categories, "", false, csrfToken)
				@reviewSaveStatus("")
			</section>
		}
		if !available {
			<section class={ "card", templ.KV("mt-8", session.UserID==auth.Subject(ctx)) }>
				<h2>The reusable list is unavailable</h2>
				<p class="mb-3">Your trip and observations are still here.</p>
				if recoverable {
					<form method="post" action={ "/trips/" + session.ID + "/review/recover" }>
						<input type="hidden" name="_csrf" value={ csrfToken }/>
						<button class="btn btn-primary mt-2" type="submit">Create a new list from this trip</button>
					</form>
				} else {
					<p>Your access to the template was removed. Your own trip observations remain available here.</p>
				}
			</section>
		}
		@TripObservations(session, list, available, session.UserID == auth.Subject(ctx) || !available, csrfToken, nil)
		if available {
			@CurrentReviewList(list, nil)
		}
	}
}

// ReviewForm records one observation. htmx swaps the form in place, so a save
// comes back as a fresh form (new entry ID) or the submitted values with an
// error; without JavaScript it posts normally and the handler redirects.
// "Save and apply now" also applies the proposed change, so it is offered only
// while the reusable list is available and a change is proposed. focusSave
// moves focus to Save observation after that button disappears in a swap.
templ ReviewForm(session packing.PackingSession, revision string, available bool, entry packing.ReviewEntry, categories []string, message string, focusSave bool, csrfToken string) {
	<form
		id="review-form"
		method="post"
		action={ "/trips/" + session.ID + "/review" }
		hx-post={ "/trips/" + session.ID + "/review" }
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="this:drop"
		x-data="{ action: '' }"
		x-init="action = $el.elements.action.value"
		x-on:change="if ($event.target.name === 'action') action = $event.target.value"
	>
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<input type="hidden" name="entryId" value={ entry.ID }/>
		if available {
			<input type="hidden" name="revision" value={ revision }/>
		}
		@Select("review-item", "itemId", "Existing gear (optional)", reviewItemOptions(session), entry.ItemID)
		<label class="block my-3 text-sm font-bold">Name of new or missing gear <input name="name" maxlength="200" value={ entry.Name } class="block w-full max-w-[34rem] mt-1 min-h-11 p-2 rounded-field border border-sand-300 bg-white font-normal"/></label>
		<div class="grid gap-1 my-3 max-w-[34rem]">
			<label for="review-category" class="text-sm font-bold">Category</label>
			@CategoryPicker("review-category", "review-category-options", entry.Category, "Pick or type one", categories)
		</div>
		<fieldset class="min-w-0 mb-4">
			<legend class="mb-2 text-sm font-bold">Observations (choose at least one)</legend>
			<label class="flex items-center gap-2 mt-3 mb-2"><input type="checkbox" name="forgotten" value="true" checked?={ entry.Forgotten } class="min-h-8 align-middle"/>Forgotten</label>
			<label class="flex items-center gap-2 mt-3 mb-2"><input type="checkbox" name="unused" value="true" checked?={ entry.Unused } class="min-h-8 align-middle"/>Unused</label>
			<label class="flex items-center gap-2 mt-3 mb-2"><input type="checkbox" name="needsAttention" value="true" checked?={ entry.NeedsAttention } class="min-h-8 align-middle"/>Needs repair or replacement</label>
		</fieldset>
		<label class="block my-3 text-sm font-bold">Notes <textarea name="note" maxlength="2000" class="block w-full max-w-[34rem] mt-1 min-h-22 px-3 py-2 rounded-field border border-sand-300 bg-white font-normal">{ entry.Note }</textarea></label>
		@Select("review-action", "action", "Proposed change", reviewActionOptions, string(entry.Action))
		<label class="block my-3 text-sm font-bold">Preparation task (when selected) <input name="task" maxlength="200" value={ entry.Task } placeholder="Replace gas canister" class="block w-full max-w-[34rem] mt-1 min-h-11 p-2 rounded-field border border-sand-300 bg-white font-normal"/></label>
		<p class="text-muted mb-3">Saving keeps the observation with this trip. A proposed change reaches your reusable list only when you apply it. Unused safety equipment may still be essential; nothing is removed automatically.</p>
		// The error sits by the buttons, where a phone user who just tapped one is looking.
		if message != "" {
			<p class="error" role="alert">{ message }</p>
		}
		<div class="flex flex-wrap items-center gap-2 mt-2">
			<button id="review-submit" class="btn btn-primary in-[.htmx-request]:opacity-60 in-[.htmx-request]:cursor-progress" type="submit" autofocus?={ focusSave }>Save observation</button>
			if available {
				<button
					id="review-save-apply"
					class="btn btn-secondary in-[.htmx-request]:opacity-60 in-[.htmx-request]:cursor-progress"
					type="submit"
					name="apply"
					value="true"
					hidden?={ entry.Action == "" || entry.Action == packing.ReviewObserve }
					x-bind:hidden="action === 'none'"
				>Save and apply now</button>
			}
		</div>
	</form>
}

var reviewActionOptions = []SelectOption{
	{Value: string(packing.ReviewObserve), Label: "Keep observation only"},
	{Value: string(packing.ReviewAdd), Label: "Add gear to future lists"},
	{Value: string(packing.ReviewRemove), Label: "Remove selected existing gear"},
	{Value: string(packing.ReviewTask), Label: "Create a preparation task"},
}

func reviewItemOptions(session packing.PackingSession) []SelectOption {
	options := []SelectOption{{Value: "", Label: "New or missing gear"}}
	for _, item := range session.List.Items {
		options = append(options, SelectOption{Value: item.ID, Label: item.Name})
	}
	return options
}

// reviewSaveStatus stays in the page so screen readers announce the text an
// out-of-band swap puts inside it.
templ reviewSaveStatus(text string) {
	<p id="review-save-status" role="status" class="text-sm text-muted mt-3 empty:mt-0">{ text }</p>
}

// reviewChange describes a proposed change as a sentence, for the apply
// checkbox and the applied confirmation.
func reviewChange(observation packing.ReviewEntry) string {
	switch observation.Action {
	case packing.ReviewAdd:
		return "Add " + observation.Name + " to the list"
	case packing.ReviewRemove:
		return "Remove " + observation.Name + " from the list"
	case packing.ReviewTask:
		return "Add the preparation task " + observation.Task
	}
	return "Keep " + observation.Name + " as an observation"
}

// TripObservations lists this trip's observations with the apply form. spaced
// adds the gap it needs when another card sits above it. Each proposed change
// is labelled applied or waiting, from the list's applied reviews, while the
// list is available.
templ TripObservations(session packing.PackingSession, list packing.PackingList, available bool, spaced bool, csrfToken string, attrs templ.Attributes) {
	<section id="trip-observations" class={ "card", templ.KV("mt-8", spaced) } { attrs... }>
		<h2>Trip observations</h2>
		if len(session.Review) == 0 {
			<p class="mb-3">No observations yet.</p>
		}
		<form method="post" action={ "/trips/" + session.ID + "/review/apply" }>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			<input type="hidden" name="revision" value={ list.Revision() }/>
			for _, observation := range session.Review {
				<article class="py-3 border-b border-sand-100 last-of-type:border-b-0">
					<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
						<h3 class="mt-0">{ observation.Name }</h3>
						if available && observation.Action != packing.ReviewObserve {
							if slices.Contains(list.AppliedReviews, session.ID + ":" + observation.ID) {
								<span class="tag">Applied</span>
							} else {
								<span class="tag tag-quiet">Waiting to be applied</span>
							}
						}
					</div>
					<p class="mb-3">
						if observation.Forgotten {
							<span>Forgotten. </span>
						}
						if observation.Unused {
							<span>Unused. </span>
						}
						if observation.NeedsAttention {
							<span>Needs attention. </span>
						}
						{ observation.Note }
					</p>
					if observation.Action != packing.ReviewObserve {
						if slices.Contains(list.AppliedReviews, session.ID + ":" + observation.ID) {
							<p class="mb-3">{ reviewChange(observation) }. Applied to future trips.</p>
						} else if available {
							<label class="flex items-center gap-2 mt-3 mb-2">
								<input type="checkbox" name="selected" value={ observation.ID } class="min-h-8 align-middle"/>
								{ reviewChange(observation) }
							</label>
						}
					}
				</article>
			}
			if available && len(session.Review) > 0 {
				<button class="btn btn-primary mt-2" type="submit">Apply selected changes</button>
			}
		</form>
	</section>
}

// CurrentReviewList shows the reusable list the proposals compare against.
templ CurrentReviewList(list packing.PackingList, attrs templ.Attributes) {
	<section id="current-review-list" class="card mt-8" { attrs... }>
		<h2>Current reusable list: { list.Name }</h2>
		<p class="mb-3">Compare your proposals with the current list before applying.</p>
		<ul class="list-disc pl-10 mb-3">
			for _, item := range list.Items {
				<li>{ item.Name } — { item.Category }</li>
			}
		</ul>
		<ul class="list-disc pl-10">
			for _, task := range list.Tasks {
				<li>{ task.Name }</li>
			}
		</ul>
	</section>
}

// ReviewSaved answers an htmx save: a fresh form, the confirmation, and the
// observations card with the new entry. message reports a change that was
// saved but could not be applied; listChanged moves focus to Save observation
// after an apply attempt. The list card is refreshed too, so it shows the
// revision the new forms carry.
templ ReviewSaved(session packing.PackingSession, list packing.PackingList, available bool, entry packing.ReviewEntry, categories []string, saved string, message string, listChanged bool, csrfToken string) {
	@ReviewForm(session, list.Revision(), available, entry, categories, message, listChanged, csrfToken)
	<div id="review-save-status" hx-swap-oob="innerHTML">{ saved }</div>
	@TripObservations(session, list, available, true, csrfToken, templ.Attributes{"hx-swap-oob": "outerHTML"})
	if available {
		@CurrentReviewList(list, templ.Attributes{"hx-swap-oob": "outerHTML"})
	}
}

// ReviewFormError answers a failed htmx save with the form, the submitted
// values and revision, and the message, and clears an earlier confirmation.
templ ReviewFormError(session packing.PackingSession, revision string, available bool, entry packing.ReviewEntry, categories []string, message string, csrfToken string) {
	@ReviewForm(session, revision, available, entry, categories, message, false, csrfToken)
	<div id="review-save-status" hx-swap-oob="innerHTML"></div>
}
