package views

import (
	"camplist/internal/auth"
	"camplist/internal/packing"
	"github.com/google/uuid"
	"strconv"
)

// PackingSessionPage is a trip: its head with More, the save status, then
// the Packing and Before you go tabs. Adding and renaming open sheets. Without
// scripts the tabs stay stacked and both sheets' forms sit inline at the end;
// Rename trip is a link to its form for that reason.
templ PackingSessionPage(name string, session packing.PackingSession, canReview bool, categories []packing.CategoryOption, csrfToken string) {
	@Layout(name, csrfToken) {
		<section class="[&_.page-head]:flex-nowrap [&_.page-head]:mb-3">
			@PageHead(PageHeading{
				Title:     tripCardTitle(session),
				TitleID:   "trip-title",
				Meta:      tripMeta(session, auth.Subject(ctx)),
				BackHref:  "/trips",
				BackLabel: "Trips",
			}) {
				@PageMenu("More") {
					if session.UserID == auth.Subject(ctx) {
						<a class="option" role="menuitem" href="#trip-rename" x-on:click.prevent="document.getElementById('trip-rename-dialog').showModal()">Rename trip</a>
					}
					@MenuLink("/sharing/packing-session/"+session.ID, "Sharing")
					if session.UserID == auth.Subject(ctx) {
						@MenuButton("Archive trip", false, tripPageAction(session.ID, "archive"))
						@MenuSeparator()
						@MenuButton("Delete trip", true, tripPageDelete(session.ID))
					}
				}
			}
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				if canReview {
					<a class="btn btn-secondary btn-sm" href={ "/trips/" + session.ID + "/review" }>Review this trip</a>
				}
				<p class="sync-status text-caption mb-0 min-w-0 flex-[1_1_12rem] [&.card]:basis-full" id="packing-save-status" role="status">Saves as you pack. Preparing offline access…</p>
			</div>
			<div id="future-save-status" class="mt-3 empty:hidden"></div>
			<div
				x-data
				x-on:htmx:oob-before-swap="if ($event.target.id === 'trip-future-save' && $event.target.contains(document.activeElement)) queueMicrotask(() => document.getElementById('trip-entry-open')?.focus({ preventScroll: true }))"
			>
				@FutureSaveSlot(session, nil, csrfToken, false)
			</div>
		</section>
		@templ.JSONScript("packing-snapshot", session.Snapshot(auth.Subject(ctx)))
		<noscript><p class="mt-3">Packing requires a connection when JavaScript is disabled.</p></noscript>
		@PackingProgressStatus(session, false)
		<div class="mt-5">
			@TabGroup("trip", "Trip", tripTabs(session)) {
				@TabPanel("trip", 0) {
					<div class="pt-3">
						@PackingChecklist(session, csrfToken)
					</div>
				}
				@TabPanel("trip", 1) {
					<div class="pt-3">
						<noscript><h2 class="mt-5 mb-3">Before you go</h2></noscript>
						@SessionPreparation(session, csrfToken)
					</div>
				}
			}
			<button
				type="button"
				id="trip-entry-open"
				class="btn btn-secondary w-full mt-3"
				x-data
				x-cloak
				x-on:click="document.getElementById('trip-entry').showModal()"
			>Add to this trip</button>
		</div>
		@TripEntryForm(session, categories, csrfToken)
		if session.UserID == auth.Subject(ctx) {
			@TripRenameForm(session, csrfToken)
		}
	}
}

// tripDialog holds a trip page form: a sheet that opens from its button, or,
// without scripts, the form inline at the end of the page (the layout's
// noscript style shows data-noscript-inline). Closing puts focus back on
// the control that opens it.
func tripDialog(titleID string, focusOnClose string) templ.Attributes {
	return templ.Attributes{
		"aria-labelledby":      titleID,
		"x-data":               "",
		"x-on:close":           focusOnClose,
		"data-noscript-inline": "",
	}
}

// PackingProgressStatus announces the packed count to screen readers. It stays
// outside #packing-checklist so the live region survives checklist swaps;
// updates replace only its text (out of band here, directly in session.mjs).
templ PackingProgressStatus(session packing.PackingSession, oob bool) {
	if oob {
		<p id="packing-progress-status" hx-swap-oob="innerHTML">{ progressCount(session.List.CountChecked(), len(session.List.Items)) }</p>
	} else {
		<p id="packing-progress-status" class="sr-only" role="status">{ progressCount(session.List.CountChecked(), len(session.List.Items)) }</p>
	}
}

// TripTitle is the page heading; a rename swaps it out of band.
templ TripTitle(session packing.PackingSession, oob bool) {
	<h1 id="trip-title" { oobSwap(oob)... }>{ tripCardTitle(session) }</h1>
}

// TripRenameForm renames the trip from a sheet opened by More. The response
// swaps the heading and title, and the sheet closes either way, so a failure
// shows in the error toast. Without JavaScript the form posts and redirects.
templ TripRenameForm(session packing.PackingSession, csrfToken string) {
	@Dialog("trip-rename-dialog", true, tripDialog("trip-rename-title", "document.querySelector('.page-head .menu-trigger')?.focus()")) {
		<form
			id="trip-rename"
			method="post"
			action={ "/trips/" + session.ID + "/name" }
			hx-post={ "/trips/" + session.ID + "/name" }
			hx-swap="none"
			hx-sync="this:drop"
			hx-on::after-request="this.closest('dialog').close()"
			class="[&.htmx-request]:opacity-60"
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			<h2 id="trip-rename-title" class="dialog-title">Rename trip</h2>
			@Field(TextField{
				ID:    "rename-trip",
				Name:  "name",
				Label: "Trip name",
				Value: session.DisplayName(),
				Attrs: templ.Attributes{"required": true, "maxlength": "200"},
			})
			<div class="flex flex-wrap items-center justify-end gap-2 mt-4 max-sm:*:flex-auto">
				<button type="button" class="btn btn-secondary" x-cloak x-on:click="$el.closest('dialog').close()">Cancel</button>
				<button class="btn btn-primary">Save name</button>
			</div>
		</form>
	}
}

// TripRenamed answers an htmx rename with the heading and the document title.
templ TripRenamed(session packing.PackingSession) {
	@DocumentTitle(session.DisplayName())
	@TripTitle(session, true)
}

// PackingChecklist is the Packing tab: progress, then the gear.
// static/offline/session.mjs renders [data-trip-items] itself once it mounts,
// with static/offline/checklist.mjs, which builds the same markup.
templ PackingChecklist(session packing.PackingSession, csrfToken string) {
	<section id="packing-checklist" aria-label="Packing checklist">
		@PackingProgress(session, false)
		<div data-trip-items>
			if len(session.List.Items) == 0 {
				<p class="card text-muted">Nothing to pack yet. Add something to this trip below.</p>
			}
			for i, person := range groupByPerson(session.List.Items, session.IsShared(), auth.Subject(ctx)) {
				if len(person.Items) == 0 {
					continue
				}
				if person.Name != "" {
					<h2 class="person-head">
						<span>{ person.Name }</span>
						@groupCountLabel(packCountID("pack-count", i), checkedCount(person.Items), len(person.Items), false, false)
					</h2>
				}
				<div class="pack-sheet">
					for j, group := range groupByCategory(person.Items) {
						<div class="pack-group">
							if group.Name != "" {
								@categoryHead(person.Name != "") {
									<span>{ group.Name }</span>
									@groupCountLabel(packCountID("pack-count", i, j), checkedCount(group.Items), len(group.Items), false, false)
								}
							}
							<ul>
								for _, item := range group.Items {
									@PackingSessionItem(session.ID, item, person.Name == "" && item.Assignee == auth.Subject(ctx), csrfToken)
								}
							</ul>
						</div>
					}
				</div>
			}
		</div>
	</section>
}

// categoryHead names a category group: a section-level heading, or one level
// down inside a person's part of a shared trip.
templ categoryHead(nested bool) {
	if nested {
		<h3 class="group-head">
			{ children... }
		</h3>
	} else {
		<h2 class="group-head">
			{ children... }
		</h2>
	}
}

// groupCountLabel is a group's count. A toggle answers with every count of
// the checklist out of band, by id.
templ groupCountLabel(id string, done int, total int, task bool, oob bool) {
	<span id={ id } class={ groupCountClass(done, total) } { oobSwap(oob)... }>{ groupCount(done, total, task) }</span>
}

// PackingGroupCounts sends every group count of the checklist out of band.
// A toggle never regroups items, so the ids still match.
templ PackingGroupCounts(session packing.PackingSession) {
	for i, person := range groupByPerson(session.List.Items, session.IsShared(), auth.Subject(ctx)) {
		if person.Name != "" {
			@groupCountLabel(packCountID("pack-count", i), checkedCount(person.Items), len(person.Items), false, true)
		}
		for j, group := range groupByCategory(person.Items) {
			if group.Name != "" {
				@groupCountLabel(packCountID("pack-count", i, j), checkedCount(group.Items), len(group.Items), false, true)
			}
		}
	}
}

// PackingProgress is the sticky progress card. A packed row swaps it out of
// band so a toggle does not resend the whole checklist.
templ PackingProgress(session packing.PackingSession, oob bool) {
	if allPacked(session.List.CountChecked(), len(session.List.Items)) {
		<div id="packing-progress" class="card card-brand progress-card mb-3" { oobSwap(oob)... }>
			<p class="display mb-3">All packed. Go!</p>
			@ProgressBar(session.List.CountChecked(), len(session.List.Items), "")
		</div>
	} else {
		<div id="packing-progress" class="card progress-card mb-3" { oobSwap(oob)... }>
			@ProgressBar(session.List.CountChecked(), len(session.List.Items), "Keep packing")
		</div>
	}
}

// PackingSessionItem swaps only its form's contents, so the form stays in the
// page. Its hx-sync and hx-indicator (shared with the task toggles in
// SessionPreparation) drop repeat presses and dim the section while one saves.
// Unlike hx-disabled-elt they keep the pressed button enabled, so htmx puts
// focus back on it by id after the swap. The offline module replaces these
// forms once it mounts. mine tags a personal item on a checklist that is not
// split by person.
templ PackingSessionItem(sessionID string, item packing.PackingItem, mine bool, csrfToken string) {
	<li class="pack-item">
		<form
			method="post"
			action="/trips/set-item"
			class="pack-form w-full"
			hx-post="/trips/set-item"
			hx-target="this"
			hx-swap="innerHTML"
			hx-sync="closest section:drop"
			hx-indicator="closest section"
		>
			@PackingItemToggle(sessionID, item, mine, csrfToken)
		</form>
	</li>
}

templ PackingItemToggle(sessionID string, item packing.PackingItem, mine bool, csrfToken string) {
	<input type="hidden" name="_csrf" value={ csrfToken }/>
	<input type="hidden" name="sessionId" value={ sessionID }/>
	<input type="hidden" name="itemId" value={ item.ID }/>
	<input type="hidden" name="expectedRevision" value={ strconv.FormatInt(item.Revision, 10) }/>
	<input type="hidden" name="checked" value={ strconv.FormatBool(!item.Checked) }/>
	<button
		id={ "pack-" + item.ID }
		type="submit"
		class={ "pack-row", templ.KV("packed", item.Checked) }
		aria-pressed={ strconv.FormatBool(item.Checked) }
		disabled?={ item.Assignee!="" && item.Assignee!=auth.Subject(ctx) }
	>
		@packRowContent(item.Name, changedByCaption(item.ChangedBy, item.ChangedByID, auth.Subject(ctx), item.Checked, false), mine)
	</button>
}

// packRowContent is the inside of a tick row: the tick, the name with who else
// changed it, and a Yours tag. The button's text is its accessible name.
templ packRowContent(name string, caption string, mine bool) {
	<span class="tick" aria-hidden="true"></span>
	<span class="pack-text">
		<span class="pack-name">{ name }</span>
		if caption != "" {
			<span class="pack-by">{ caption }</span>
		}
	</span>
	if mine {
		<span class="tag tag-quiet">Yours</span>
	}
}

// PackingItemSaved answers an htmx toggle: the row's controls plus, out of
// band, the progress card, the group and tab counts, and the status.
templ PackingItemSaved(session packing.PackingSession, item packing.PackingItem, csrfToken string) {
	@PackingItemToggle(session.ID, item, item.Assignee == auth.Subject(ctx) && !splitByPerson(session.List.Items, session.IsShared()), csrfToken)
	@PackingProgress(session, true)
	@PackingGroupCounts(session)
	@tripTabCount("trip-packing-count", packingTabCount(session))
	@PackingProgressStatus(session, true)
}

// tripTabCount replaces a tab's count out of band.
templ tripTabCount(id string, count string) {
	<span id={ id } class="tab-count" hx-swap-oob="true">{ count }</span>
}

// SessionPreparation is the Before you go tab: what changed on the list since
// the last trip from it, then the trip's preparation tasks as tick rows.
templ SessionPreparation(session packing.PackingSession, csrfToken string) {
	<section id="session-preparation" aria-label="Before you go">
		if len(session.Improvements) > 0 {
			<div class="card bg-pine-100 border-pine-100 mb-3 py-3">
				<p class="font-bold">Since your last trip</p>
				<ul class="mt-1 grid gap-0.5 text-meta">
					for _, change := range session.Improvements {
						<li>{ change }</li>
					}
				</ul>
			</div>
		}
		if len(session.List.Tasks) == 0 {
			<p class="card text-muted mb-3">No preparation tasks on this trip.</p>
		}
		for i, person := range groupPreparationByPerson(session.List.Tasks, session.IsShared(), auth.Subject(ctx)) {
			if len(person.Tasks) > 0 {
				if person.Name != "" {
					<h2 class="person-head">
						<span>{ person.Name }</span>
						@groupCountLabel(packCountID("task-count", i), doneCount(person.Tasks), len(person.Tasks), true, false)
					</h2>
				}
				<div class="pack-sheet">
					<ul>
						for _, task := range person.Tasks {
							@sessionTask(session, task, person.Name == "" && task.Assignee == auth.Subject(ctx), csrfToken)
						}
					</ul>
				</div>
			}
		}
		<p class="text-meta text-muted">Done here counts for this trip only. <a href={ "/packing-lists/" + session.TemplateID() }>Edit tasks on the list</a></p>
	</section>
}

templ sessionTask(session packing.PackingSession, task packing.PreparationTask, mine bool, csrfToken string) {
	<li class="pack-item">
		<form
			method="post"
			action={ "/trips/" + session.ID + "/preparation" }
			hx-post={ "/trips/" + session.ID + "/preparation" }
			hx-target="#session-preparation"
			hx-swap="outerHTML"
			hx-sync="closest section:drop"
			hx-indicator="closest section"
			class="pack-form w-full"
			data-task-form
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			<input type="hidden" name="taskId" value={ task.ID }/>
			<input type="hidden" name="done" value={ strconv.FormatBool(!task.Done) }/>
			<input type="hidden" name="expectedRevision" value={ strconv.FormatInt(task.Revision, 10) }/>
			<button
				id={ "pack-" + task.ID }
				disabled?={ task.Assignee!="" && task.Assignee!=auth.Subject(ctx) }
				type="submit"
				class={ "pack-row", templ.KV("packed",task.Done) }
				aria-pressed={ strconv.FormatBool(task.Done) }
			>
				@packRowContent(task.Name, changedByCaption(task.ChangedBy, task.ChangedByID, auth.Subject(ctx), task.Done, true), mine)
			</button>
		</form>
	</li>
}

// SessionPreparationSaved answers a task toggle: the tab, and its count out
// of band.
templ SessionPreparationSaved(session packing.PackingSession, csrfToken string) {
	@SessionPreparation(session, csrfToken)
	@tripTabCount("trip-tasks-count", tasksTabCount(session))
}

// TripEntryForm adds to the trip from a sheet. The response swaps the
// checklist or preparation section that gained the entry, the tab counts, the
// next operation ID, the category suggestions and the future-save notice; the
// sheet closes either way, so a failure shows in the error toast.
templ TripEntryForm(session packing.PackingSession, categories []packing.CategoryOption, csrfToken string) {
	@Dialog("trip-entry", true, tripDialog("trip-entry-title", "document.getElementById('trip-entry-open')?.focus()")) {
		<form
			id="trip-entry-form"
			method="post"
			action={ "/trips/" + session.ID + "/entries" }
			{ tripEntryRequest(session.ID)... }
			hx-on::after-request="this.closest('dialog').close(); if (event.detail.successful) this.reset()"
			class="grid gap-4 [&.htmx-request]:opacity-60"
		>
			<input type="hidden" name="_csrf" value={ csrfToken }/>
			@TripEntryOperation(false)
			<h2 id="trip-entry-title" class="dialog-title mb-0">Add to this trip</h2>
			@Field(TextField{
				ID:    "entry-name",
				Name:  "name",
				Label: "Name",
				Attrs: templ.Attributes{"required": true, "maxlength": "200"},
			})
			<div class="min-w-0">
				<label for="entry-category" class="label">Category</label>
				@CategoryPicker("entry-category", "trip-categories", "", "Pick or type one", categories)
			</div>
			<div class="grid gap-3 sm:grid-cols-2">
				@SelectField("entry-kind", "kind", "Type", false, entryKindOptions, "")
				@ScopeSelect("scope", "entry-scope", "", true, false)
			</div>
			<div>
				@Switch("saveForFuture", "Also add to the list", false, templ.Attributes{"aria-describedby": "entry-save-hint"})
				<p id="entry-save-hint" class="hint mt-0 pl-14">Future trips from { session.List.Name } get it too. Needs edit access to the list.</p>
			</div>
			<div class="flex flex-wrap items-center justify-end gap-2 max-sm:*:flex-auto">
				<button type="button" class="btn btn-secondary" x-cloak x-on:click="$el.closest('dialog').close()">Cancel</button>
				<button class="btn btn-primary">Add to trip</button>
			</div>
		</form>
	}
}

// TripEntryOperation carries a fresh ID so a retried add is not saved twice.
templ TripEntryOperation(oob bool) {
	<input type="hidden" id="trip-entry-operation" name="operationId" value={ uuid.NewString() } { oobSwap(oob)... }/>
}

// TripCategories refreshes the entry form's category picker options after an add.
templ TripCategories(categories []packing.CategoryOption) {
	<datalist id="trip-categories" hx-swap-oob="true">
		@categoryOptions(categories)
	</datalist>
}

// FutureSaveSlot is a live region under the trip's head that shows failed,
// when set, as a notice. Its contents swap so screen readers announce the
// change.
templ FutureSaveSlot(session packing.PackingSession, failed *packing.PackingOperation, csrfToken string, oob bool) {
	<div
		id="trip-future-save"
		role="status"
		if oob {
			hx-swap-oob="innerHTML"
		}
	>
		if failed != nil {
			<div class="card mt-3 mb-0">
				<h2 class="t-object">Saved to this trip</h2>
				@FutureSaveRetry(session, *failed, csrfToken, true)
			</div>
		}
	</div>
}

// TripEntrySaved answers an htmx add. The checklist and preparation sections
// are picked out by the form's hx-select-oob; the rest swap by id.
templ TripEntrySaved(session packing.PackingSession, op packing.PackingOperation, categories []packing.CategoryOption, failed bool, csrfToken string) {
	if op.Kind == "task" {
		@SessionPreparation(session, csrfToken)
		@tripTabCount("trip-tasks-count", tasksTabCount(session))
	} else {
		@PackingChecklist(session, csrfToken)
		@tripTabCount("trip-packing-count", packingTabCount(session))
		@PackingProgressStatus(session, true)
	}
	@TripEntryOperation(true)
	@TripCategories(categories)
	if failed {
		@FutureSaveSlot(session, &op, csrfToken, true)
	} else {
		@FutureSaveSlot(session, nil, csrfToken, true)
	}
}

// FutureSaveResult is the no-JavaScript page for an entry that reached the trip
// but not the reusable list.
templ FutureSaveResult(session packing.PackingSession, op packing.PackingOperation, csrfToken string) {
	@Layout("Trip entry saved", csrfToken) {
		<section class="card">
			<h1>Saved to this trip</h1>
			@FutureSaveRetry(session, op, csrfToken, false)
		</section>
	}
}

// FutureSaveRetry explains a failed reusable-list save and retries it with the
// same operation ID. Inline, "Keep only in this trip" dismisses the notice and
// returns focus to Add to this trip.
templ FutureSaveRetry(session packing.PackingSession, op packing.PackingOperation, csrfToken string, inline bool) {
	<p>{ op.Name } was added. Saving it to the reusable packing list failed. You may need its owner's permission.</p>
	<form
		method="post"
		action={ "/trips/" + session.ID + "/entries" }
		if inline {
			{ tripEntryRequest(session.ID)... }
		}
	>
		<input type="hidden" name="_csrf" value={ csrfToken }/><input type="hidden" name="operationId" value={ op.ID }/><input type="hidden" name="name" value={ op.Name }/><input type="hidden" name="category" value={ op.Category }/><input type="hidden" name="scope" value={ op.Scope }/><input type="hidden" name="kind" value={ op.Kind }/><input type="hidden" name="saveForFuture" value="true"/>
		<div class="flex flex-wrap items-center gap-2 mt-4">
			<a
				class="btn btn-secondary"
				href={ "/trips/" + session.ID }
				if inline {
					x-on:click.prevent="document.getElementById('trip-entry-open')?.focus(); $el.closest('#trip-future-save').replaceChildren()"
				}
			>Keep only in this trip</a>
			<button class="btn btn-primary">Retry saving for future trips</button>
		</div>
	</form>
}
