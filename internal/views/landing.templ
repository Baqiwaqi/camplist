package views

import "strconv"

// PublicHeader frames the pages a visitor sees before signing in. The demo
// page hides the header call to action because the visitor is already there.
// On phones the hero carries the call to action; the header keeps sign-in.
templ PublicHeader(showDemo bool) {
	<header class="bg-white border-b border-sand-300 max-sm:relative">
		<nav class="max-w-[1148px] mx-auto py-4 px-4 md:px-6 flex flex-wrap items-center gap-4" aria-label="Main">
			<a class="inline-flex items-center gap-2 font-bold no-underline max-sm:-my-2 max-sm:py-2" href="/">
				<img src="/static/logomark.svg" alt="" width="22" height="22"/>
				Camplist
			</a>
			<div class="ml-auto flex items-center gap-4 sm:gap-6">
				<a class="font-bold no-underline max-sm:hidden" href="/#how">How it works</a>
				<a class="font-bold no-underline max-sm:-my-2 max-sm:py-2" href="/auth/login">Sign in with Google</a>
				if showDemo {
					<a class="btn btn-accent max-sm:hidden" href="/demo">Try a demo list</a>
				}
			</div>
		</nav>
	</header>
}

templ PublicFooter() {
	<footer class="bg-white border-t border-sand-300 mt-8">
		<div class="max-w-[1148px] mx-auto py-4 px-4 md:px-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-muted max-md:flex-col max-md:items-start">
			<span class="inline-flex items-center gap-2 text-ink-900 font-bold">
				<img src="/static/logomark.svg" alt="" width="18" height="18"/>
				Camplist
			</span>
			<a class="font-bold no-underline md:ml-auto" href="https://github.com/Baqiwaqi/camplist">Open source on GitHub</a>
			<a class="font-bold no-underline" href="/auth/login">Sign in with Google</a>
		</div>
	</footer>
}

// Landing is the page visitors see at /. The hero is a working packing
// session rather than a screenshot, and the only explainer is the one idea
// people must get: the list is the template, each trip is a session.
// Marketing pages use a wider column than the app.
templ Landing() {
	@Shell("Packing lists for campers") {
		@PublicHeader(true)
		<main class="max-w-[1148px] mx-auto px-4 md:px-6 flex flex-col gap-12 md:gap-24 pt-8 md:pt-18 pb-8 md:pb-20">
			<section class="grid items-center gap-6 md:grid-cols-[1.1fr_1fr] md:gap-x-16 md:gap-y-8">
				<div>
					<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700 mb-2">Packing lists for campers</p>
					<h1 class="text-[clamp(2.5rem,1.75rem+3.5vw,4rem)] mb-4">Pack once. Go every weekend.</h1>
					<p class="text-xl md:max-w-[34ch] mb-6 text-pretty">Build your camping list one time. Start a session for each trip and check things off as you pack. Your list stays untouched.</p>
					<div class="flex flex-wrap items-center gap-2 mb-3 max-md:*:flex-auto">
						<a class="btn btn-accent btn-lg" href="/demo">Try a demo list</a>
						<a class="btn btn-secondary btn-lg max-sm:hidden" href="/auth/login">Sign in with Google</a>
					</div>
					<p class="text-muted text-sm max-md:text-center">Free. No list caps. Works in any browser.</p>
				</div>
				@DemoPreview(heroItems)
			</section>
			<section id="how">
				<div class="max-w-[60ch] mb-6 md:mb-8">
					<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700 mb-2">List vs session</p>
					<h2 class="text-[clamp(2rem,1.5rem+2vw,2.75rem)] mb-3">Your list is the template. Each trip is a session.</h2>
					<p class="text-lg text-pretty">Other apps make you rebuild or reset the same list every trip. In Camplist, packing items in a session never changes the list, so next weekend starts clean.</p>
				</div>
				<div class="grid items-center gap-6 md:grid-cols-[1fr_auto_1fr]">
					<div class="card mb-0">
						<div class="flex justify-between items-baseline gap-3 text-sm">
							<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700">Your list</p>
							<span class="text-muted">Edit any time</span>
						</div>
						<p class="display text-2xl mt-2 mb-3">Car camping</p>
						<ul>
							for _, item := range templateItems {
								<li class="item-row flex-nowrap">
									<span class="font-bold min-w-0 wrap-anywhere">{ item.Name }</span>
									<span class="ml-auto inline-block whitespace-nowrap text-xs font-bold tracking-tag uppercase text-pine-700 bg-pine-100 px-2 py-0.5 rounded-full">{ item.Category }</span>
								</li>
							}
						</ul>
						<p class="text-muted text-sm mt-3">One list per kind of trip. Reuse it for years.</p>
					</div>
					<div class="flex flex-col items-center gap-2 text-sm text-muted text-center" aria-hidden="true">
						<span class="btn btn-primary cursor-default">Start session</span>
						<span>copies the list</span>
					</div>
					<div class="card mb-0">
						<div class="flex justify-between items-baseline gap-3 text-sm">
							<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700">Session</p>
							<span class="text-muted">Started Oct 3</span>
						</div>
						<p class="display text-2xl mt-2 mb-3">Car camping</p>
						<ul class="mb-4">
							for _, item := range templateItems {
								<li class="item-row flex-nowrap packed">
									<span class="tick" aria-hidden="true"></span>
									<span class="font-bold min-w-0 wrap-anywhere">{ item.Name }</span>
									<span class="ml-auto text-sm font-bold text-pine-700">Packed</span>
								</li>
							}
						</ul>
						@ProgressBar(len(templateItems), len(templateItems), "All packed")
					</div>
				</div>
			</section>
			<section class="grid gap-6 md:grid-cols-3">
				<div class="border-t border-sand-300 pt-4">
					<h3 class="text-2xl mt-0 mb-2">Free, no list caps</h3>
					<p class="text-muted">Make as many lists and sessions as you have trips. Nothing sits behind a paywall.</p>
				</div>
				<div class="border-t border-sand-300 pt-4">
					<h3 class="text-2xl mt-0 mb-2">Any device</h3>
					<p class="text-muted">Plan on the laptop, check off on your phone by the car. It is a web page, so there is nothing to install.</p>
				</div>
				<div class="border-t border-sand-300 pt-4">
					<h3 class="text-2xl mt-0 mb-2">No spreadsheets</h3>
					<p class="text-muted">Name, category, packed. No gram counts, no gear catalog, no calorie math.</p>
				</div>
			</section>
			<section>
				<div class="card card-brand mb-0 flex flex-wrap justify-between items-center gap-8 p-6 md:p-10 max-md:flex-col max-md:items-stretch">
					<div>
						<p class="display text-[clamp(2rem,1.5rem+2vw,2.75rem)] mb-2">Where to next?</p>
						<p class="text-lg text-pine-100">Try the demo list. No account needed.</p>
					</div>
					<a class="btn btn-accent btn-lg" href="/demo">Try a demo list</a>
				</div>
			</section>
		</main>
		@PublicFooter()
	}
}

// DemoPreview is the hero session: rows toggle in Alpine state and the
// progress bar follows. The markup is rendered in its initial state so the
// page does not change when Alpine starts.
templ DemoPreview(items []demoItem) {
	<div class="grid gap-3" x-data={ demoState(items) }>
		<div class="card card-brand mb-0">
			<p class="text-xs font-bold tracking-eyebrow uppercase text-pine-100 mb-2">Packing session</p>
			<p class="display text-[1.75rem] mb-4">Weekend at the lake</p>
			@DemoProgress(items, "All packed. Go!")
		</div>
		<div class="card mb-0">
			<ul>
				for i, item := range items {
					<li class="item-row py-0">
						@DemoRow(i, item, true)
					</li>
				}
			</ul>
		</div>
	</div>
}

// DemoProgress mirrors ProgressBar with Alpine bindings. doneLabel replaces
// "Keep packing" once everything is packed; empty hides the label.
templ DemoProgress(items []demoItem, doneLabel string) {
	<div class={ "progress", templ.KV("progress-done", allPacked(packedCount(items), len(items))) } x-bind:class="{ 'progress-done': done }">
		<div class="progress-head">
			<span class="progress-label" x-text={ "done ? '" + doneLabel + "' : 'Keep packing'" }>
				if allPacked(packedCount(items), len(items)) {
					{ doneLabel }
				} else {
					Keep packing
				}
			</span>
			<span class="progress-count" role="status" x-text="count + ' of ' + packed.length + ' items packed'">{ strconv.Itoa(packedCount(items)) } of { strconv.Itoa(len(items)) } items packed</span>
		</div>
		<div
			class="progress-track"
			role="progressbar"
			aria-label="Packing progress"
			aria-valuemin="0"
			aria-valuemax={ strconv.Itoa(len(items)) }
			aria-valuenow={ strconv.Itoa(packedCount(items)) }
			x-bind:aria-valuenow="count"
		>
			<div class="progress-fill" style={ progressWidth(packedCount(items), len(items)) } x-bind:style="'width: ' + Math.round(count * 100 / packed.length) + '%'"></div>
		</div>
	</div>
}

// DemoRow is a packing row wired to the demo state instead of the server.
templ DemoRow(index int, item demoItem, showTag bool) {
	<button
		type="button"
		class={ "pack-row", templ.KV("packed", item.Packed) }
		x-bind:class={ "{ packed: packed[" + strconv.Itoa(index) + "] }" }
		x-on:click={ "toggle(" + strconv.Itoa(index) + ")" }
		aria-pressed={ strconv.FormatBool(item.Packed) }
		x-bind:aria-pressed={ "String(packed[" + strconv.Itoa(index) + "])" }
		aria-label={ "Toggle packed status for " + item.Name }
	>
		<span class="tick" aria-hidden="true"></span>
		<span class="pack-name">{ item.Name }</span>
		if showTag {
			<span class="inline-block whitespace-nowrap text-xs font-bold tracking-tag uppercase text-pine-700 bg-pine-100 px-2 py-0.5 rounded-full">{ item.Category }</span>
		}
		<span class="pack-action" x-text={ "packed[" + strconv.Itoa(index) + "] ? 'Unpack' : 'Pack'" }>
			if item.Packed {
				Unpack
			} else {
				Pack
			}
		</span>
	</button>
}

// DemoPage is a full packing session that lives only in the browser.
templ DemoPage() {
	@Shell("Demo session") {
		@PublicHeader(false)
		<main class="max-w-[900px] mx-auto px-4 py-8">
			<section x-data={ demoState(demoSessionItems) }>
				<div class="flex flex-wrap justify-between items-start gap-4 mb-6 max-sm:flex-col max-sm:items-stretch">
					<div class="min-w-0 max-sm:flex-none sm:flex-[1_1_320px]">
						<p class="text-xs font-bold tracking-eyebrow uppercase text-ember-700 mb-2">Demo session</p>
						<h1>Weekend at the lake</h1>
						<p class="text-muted max-w-[60ch]">Pack a few things to see how a session works. Nothing here is saved. Sign in with Google when you want a list of your own.</p>
					</div>
					<div class="flex flex-wrap items-center gap-2 sm:pt-6">
						<button type="button" class="btn btn-secondary" x-on:click="reset()">Reset demo</button>
						<a class="btn btn-accent max-sm:flex-auto" href="/auth/login">Sign in with Google</a>
					</div>
				</div>
				<noscript><p class="text-muted mb-3">The demo needs JavaScript to pack items.</p></noscript>
				<div class="card progress-card" x-bind:class="{ 'card-brand': done }">
					<p class="display mb-3" x-show="done" x-cloak>All packed. Go!</p>
					@DemoProgress(demoSessionItems, "")
				</div>
				<div class="card">
					<div class="columns-[14rem] gap-x-8">
						for _, group := range groupDemo(demoSessionItems) {
							<div class="break-inside-avoid pb-3 last:pb-0">
								<p class="text-xs font-bold tracking-eyebrow uppercase text-muted pb-1">{ group.Name }</p>
								<ul>
									for _, entry := range group.Items {
										<li class="item-row py-0">
											@DemoRow(entry.Index, entry.Item, false)
										</li>
									}
								</ul>
							</div>
						}
					</div>
				</div>
			</section>
		</main>
		@PublicFooter()
	}
}
